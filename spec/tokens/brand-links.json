      "role": "lg"
    },
    "size.icon.xl": {
      "from": "icons",
      "role": "xl"
    },
    "layer.base": {
      "from": "z",
      "role": "base"
    },
    "layer.dropdown": {
      "from": "z",
      "role": "dropdown"
    },
    "layer.sticky": {
      "from": "z",
      "role": "sticky"
    },
    "layer.overlay": {
      "from": "z",
      "role": "overlay"
    },
    "layer.modal": {
      "from": "z",
      "role": "modal"
    },
    "layer.toast": {
      "from": "z",
      "role": "toast"
    }
  }
}
