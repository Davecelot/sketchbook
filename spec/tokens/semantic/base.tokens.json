  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.150}"
      },
      "normal": {
        "$value": "{duration.200}"
      },
      "slow": {
        "$value": "{duration.300}"
      },
      "loop": {
        "$value": "{duration.1000}"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{easing.standard}"
      },
      "enter": {
        "$value": "{easing.out}"
      },
      "exit": {
        "$value": "{easing.in}"
      },
      "linear": {
        "$value": "{easing.linear}"
      }
