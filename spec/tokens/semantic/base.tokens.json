  "elevation": {
    "$type": "shadow",
    "xs": {
      "$value": "{shadow.xs}"
    },
    "sm": {
      "$value": "{shadow.sm}"
    },
    "md": {
      "$value": "{shadow.md}"
    },
    "lg": {
      "$value": "{shadow.lg}"
    }
