      "2xs": {
        "$value": "{space.0-5}"
      },
      "snug": {
        "$value": "{space.1-5}"
      },
      "cozy": {
        "$value": "{space.2-5}"
      },
      "xl": {
        "$value": "{space.6}"
      },
      "tight": {
        "$value": "{space.1}"
      },
      "loose": {
        "$value": "{space.4}"
      }
