        "$value": "{space.0-5}",
        "$type": "dimension"
      }
    },
    "none": {
      "$value": "{space.0}",
      "$type": "dimension",
      "$description": "Zero, so a 0 in the design file is bound to a token instead of left unlinked."
    }
  },
  "radius": {
    "$type": "dimension",
    "small": {
      "$value": "{radius.sm}"
    },
    "control": {
      "$value": "{radius.md}"
    },
    "surface": {
      "$value": "{radius.lg}"
    },
    "large": {
      "$value": "{radius.xl}"
    },
    "pill": {
      "$value": "{radius.full}"
    },
    "xsmall": {
      "$value": "{radius.xs}",
      "$description": "Smallest corner (checkbox). Follows radius.style through the foundation radius.xs."
    },
    "square": {
      "$value": "{radius.none}",
      "$description": "Zero corner (square), so a 0 radius in the design file is bound to a token. Named square: radius.none is the foundation step."
    }
  },
  "border-width": {
    "$type": "dimension",
    "default": {
      "$value": "{border.width.1}"
    },
    "quote": {
      "$value": "{border.width.2}"
    },
    "thick": {
      "$value": "{border.width.2}"
    },
    "indicator": {
      "$value": "{border.width.2}"
    },
    "none": {
      "$value": "{border.width.0}",
      "$description": "Zero, so a 0 in the design file is bound to a token instead of left unlinked."
    }
  },
  "focus": {
    "ring": {
      "$type": "dimension",
      "width": {
        "$value": "{border.width.3}"
      },
      "offset": {
        "$value": "{border.width.0}"
      }
