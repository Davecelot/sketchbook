{
  "$id": "brand-config.schema.json",
  "title": "brand.config",
  "$description": "v2: every foundation key is optional and accepts a preset id, { preset }, { custom }, plus fine overrides of the preset values. Presets: harness/standards/*.json (sketchbook presets [family]). v1 configs stay valid.",
  "type": "object",
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$description": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {
          "anyOf": [
            {
              "$ref": "#/$defs/hex"
            },
            {
              "const": "neutral"
            }
          ]
        },
        "neutral": {
          "anyOf": [
            {
              "$ref": "#/$defs/presetId"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "preset": {
                  "$ref": "#/$defs/presetId"
                },
                "custom": {},
                "$description": {
                  "type": "string"
                },
                "hue": {
                  "type": "number"
                },
                "chroma": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "accents": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/hex"
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "destructive": {
              "type": "string",
              "minLength": 1
            },
            "success": {
              "type": "string",
              "minLength": 1
            },
            "warning": {
              "type": "string",
              "minLength": 1
            },
            "info": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ramp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "oklch"
              ]
            },
            "preset": {
              "enum": [
                "oklch"
              ]
            },
            "steps": {
              "type": "array",
              "minItems": 3,
              "items": {
                "enum": [
                  50,
                  100,
                  200,
                  300,
                  400,
                  500,
                  600,
                  700,
                  800,
                  900,
                  950
                ]
              }
            }
          }
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z]+$"
              },
              "role": {
                "enum": [
                  "light",
                  "dark"
                ]
              }
            }
          }
        ]
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        },
        "mono": {
          "type": "string"
        },
        "baseSize": {
          "type": "number"
        },
        "scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/presetId"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "preset": {
                  "$ref": "#/$defs/presetId"
                },
                "custom": {},
                "$description": {
                  "type": "string"
                },
                "ratio": {
                  "type": "number"
                },
                "sizes": {
                  "$ref": "#/$defs/numberMap"
                },
                "leading": {
                  "$ref": "#/$defs/numberMap"
                }
              }
            }
          ]
        },
        "lineHeights": {
          "anyOf": [
            {
              "$ref": "#/$defs/presetId"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "preset": {
                  "$ref": "#/$defs/presetId"
                },
                "custom": {},
                "$description": {
                  "type": "string"
                },
                "named": {
                  "$ref": "#/$defs/numberMap"
                },
                "text": {
                  "type": "number"
                },
                "display": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "letterSpacing": {
          "anyOf": [
            {
              "$ref": "#/$defs/presetId"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "properties": {
                "preset": {
                  "$ref": "#/$defs/presetId"
                },
                "custom": {},
                "$description": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "weights": {
          "anyOf": [
            {
              "$ref": "#/$defs/presetId"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "properties": {
                "preset": {
                  "$ref": "#/$defs/presetId"
                },
                "custom": {},
                "$description": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "google",
                "url",
                "local",
                "none"
              ]
            },
            "family": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "display": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "weight": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "style": {
                    "type": "string"
                  }
                }
              }
            },
            "mono": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "family"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "family": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "weights": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "files": {
                      "type": "array",
                      "items": {
                "type": "object",
                "required": [
                  "path"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "weight": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "style": {
                    "type": "string"
                  }
                }
              }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "spacing": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            },
            "base": {
              "type": "number"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "radius": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            },
            "style": {
              "enum": [
                "sharp",
                "soft",
                "round"
              ]
            },
            "base": {
              "type": "number"
            },
            "scale": {
              "$ref": "#/$defs/numberMap"
            },
            "roles": {
              "$ref": "#/$defs/stringMap"
            }
          }
        }
      ]
    },
    "elevation": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            },
            "shadows": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "number"
                }
              }
            },
            "roles": {
              "$ref": "#/$defs/stringMap"
            }
          }
        }
      ]
    },
    "motion": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            },
            "durations": {
              "$ref": "#/$defs/numberMap"
            },
            "easings": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "number"
                }
              }
            },
            "roles": {
              "$ref": "#/$defs/stringMap"
            }
          }
        }
      ]
    },
    "density": {
      "anyOf": [
        {
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ]
        },
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            },
            "height": {
              "$ref": "#/$defs/numberMap"
            },
            "padding-x": {
              "$ref": "#/$defs/stringMap"
            },
            "gap": {
              "$ref": "#/$defs/stringMap"
            }
          }
        }
      ]
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standard": {
          "enum": [
            "WCAG21-AA",
            "WCAG21-AAA",
            "wcag-aa",
            "wcag-aaa"
          ]
        },
        "preset": {
          "enum": [
            "wcag-aa",
            "wcag-aaa"
          ]
        },
        "targets": {
          "$ref": "#/$defs/numberMap"
        },
        "apca": {
          "type": "boolean"
        }
      }
    },
    "grid": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            },
            "columns": {
              "type": "number"
            },
            "gutter": {
              "type": "number"
            },
            "margin": {
              "type": "number"
            }
          }
        }
      ]
    },
    "breakpoints": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            }
          }
        }
      ]
    },
    "icons": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            }
          }
        }
      ]
    },
    "z": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            },
            "values": {
              "$ref": "#/$defs/numberMap"
            },
            "roles": {
              "$ref": "#/$defs/stringMap"
            }
          }
        }
      ]
    },
    "opacity": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            }
          }
        }
      ]
    },
    "border": {
      "anyOf": [
        {
          "$ref": "#/$defs/presetId"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "properties": {
            "preset": {
              "$ref": "#/$defs/presetId"
            },
            "custom": {},
            "$description": {
              "type": "string"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "presetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "numberMap": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
