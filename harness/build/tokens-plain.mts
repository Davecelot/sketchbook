// Token build adapter "plain": the same output contract as the Style Dictionary adapter, with no
// dependency. Swap with `sketchbook swap tokens plain`. It writes generated/css/tokens.css (first mode in :root,
// other modes override their semantic tokens) and generated/tokens/component.tokens.json.
import { mkdir, readFile, writeFile } from 'node:fs/promises';
import { join } from 'node:path';
import type { BrandConfig } from '../../generated/types/brand-config.js';
import type { HarnessConfigJson } from '../../generated/types/harness-config.js';
import { ALIAS, componentTokensDoc, componentTokensFromContracts, loadAll, loadContracts, type Layer, type Token } from '../lib/tokens.mjs';
import { modesOf } from '../standards/resolve.mjs';
import { parseJson } from '../lib/files.mjs';

export interface BuildOptions { root?: string; write?: boolean }
export interface BuildResult { css: string; componentJson: string }

const px = (v: unknown): string => (typeof v === 'string' ? v : String(v));

type ShadowLayer = Record<'offsetX' | 'offsetY' | 'blur' | 'spread' | 'color', unknown>;
const isShadowLayer = (s: unknown): s is ShadowLayer => typeof s === 'object' && s !== null;

function cssValue(token: Token, prefix: string): string {
  const v = token.value;
  if (typeof v === 'string' && ALIAS.test(v)) return `var(--${prefix}-${(ALIAS.exec(v)?.[1] ?? '').replace(/\./g, '-')})`;
  if (token.type === 'color' && typeof v === 'string') return v.toLowerCase();
  if (token.type === 'cubicBezier' && Array.isArray(v)) return `cubic-bezier(${v.join(', ')})`;
  if (token.type === 'shadow') {
    const list: unknown[] = Array.isArray(v) ? v : [v];
    return list.map((s) => {
      if (!isShadowLayer(s)) throw new TypeError(`Cannot read properties of ${String(s)} (reading 'offsetX')`);
      return `${px(s.offsetX)} ${px(s.offsetY)} ${px(s.blur)} ${px(s.spread)} ${px(s.color)}`;
    }).join(', ');
  }
  if (token.type === 'fontFamily' && Array.isArray(v)) return v.join(', ');
  return px(v);
}

const block = (selector: string, tokens: Token[], prefix: string, indent = ''): string =>
  `${indent}${selector} {\n${tokens.map((t) => `${indent}  --${prefix}-${t.path.replace(/\./g, '-')}: ${cssValue(t, prefix)};`).join('\n')}\n${indent}}`;

export async function build({ root = process.cwd(), write = true }: BuildOptions = {}): Promise<BuildResult> {
  const config = parseJson<HarnessConfigJson>(await readFile(join(root, 'harness.config.json'), 'utf8'));
  const brand = parseJson<BrandConfig>(await readFile(join(root, 'brand.config.json'), 'utf8'));
  const prefix = config.prefix;
  const all = await loadAll(root);
  const componentJson = JSON.stringify(componentTokensDoc(componentTokensFromContracts(await loadContracts(root))), null, 2) + '\n';
  const [firstMode, ...rest] = modesOf(brand);
  if (!firstMode) throw new TypeError("Cannot destructure property 'name' of 'undefined' as it is undefined.");
  const first = firstMode.name;
  const byLayer = (layer: Layer, mode: string | null): Token[] => all.sets.filter((s) => s.layer === layer && (s.mode ?? null) === mode).flatMap((s) => s.tokens);
  const rootTokens = [...byLayer('foundation', null), ...byLayer('semantic', null), ...byLayer('semantic', first), ...byLayer('component', null)];
  const blocks = [block(`:root, [data-theme="${first}"]`, rootTokens, prefix)];
  for (const { name: mode, role } of rest) {
    const t = byLayer('semantic', mode);
    blocks.push(block(`[data-theme="${mode}"]`, t, prefix));
    if (role === 'dark') blocks.push(`@media (prefers-color-scheme: dark) {\n${block(':root:not([data-theme])', t, prefix, '  ')}\n}`);
  }
  const css = `/* GENERATED by harness/build (plain adapter) from spec/tokens and each spec/components/<name>/contract.json. Do not edit. */\n${blocks.join('\n\n')}\n`;
  if (write) {
    await mkdir(join(root, 'generated/css'), { recursive: true });
    await mkdir(join(root, 'generated/tokens'), { recursive: true });
    await writeFile(join(root, 'generated/css/tokens.css'), css);
    await writeFile(join(root, 'generated/tokens/component.tokens.json'), componentJson);
  }
  return { css, componentJson };
}
