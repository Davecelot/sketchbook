// generated/css/fonts.css from brand.config.json typography.source (SB-0050). Adapter-agnostic: buildTokens
// writes it next to tokens.css and check G1 compares it with a fresh build.
//   google -> @import of the Google Fonts css2 URL (families and weights in use, display=swap)
//   url    -> @import url(...)
//   local  -> @font-face rules for the listed files (paths are used as given; nothing is copied)
//   none   -> a comment-only file (default: the system stack needs no loading)
import type { BrandConfig } from '../../generated/types/brand-config.js';
import { resolveBrand, type ResolvedBrand } from '../standards/resolve.mjs';

export type FontSource = NonNullable<NonNullable<BrandConfig['typography']>['source']>;
export interface FontFile { path: string; weight?: number | string; style?: string }
export interface MonoSource { family: string; url?: string; weights?: number[]; files?: FontFile[] }

const HEADER = '/* GENERATED by harness/build/fonts.mjs from brand.config.json (typography.source). Do not edit. */';
const GENERIC = /^(ui-|system-ui$|sans-serif$|serif$|monospace$|cursive$|fantasy$|-apple-system$|BlinkMacSystemFont$)/;
const firstFamily = (stack: string | undefined): string => ((stack ?? '').split(',')[0] ?? '').trim().replace(/^["']|["']$/g, '');
const quote = (s: unknown): string => `"${String(s).replace(/"/g, '\\"')}"`;
const FORMATS: Record<string, string> = { woff2: 'woff2', woff: 'woff', ttf: 'truetype', otf: 'opentype' };
const formatOf = (path: string): string | undefined => FORMATS[(path.split('.').pop() ?? '').toLowerCase()];
const fail = (msg: string): never => { throw Object.assign(new Error(`brand.config.json typography.source: ${msg}`), { fix: 'Fix typography.source in brand.config.json (kind google|url|local|none), then npm run tokens:build.' }); };

// The weights in use: source.weights, or the generated font.weight scale.
function weightsOf(source: FontSource, resolved: ResolvedBrand): number[] {
  const w = source.weights ?? Object.values(resolved.typography.weights).filter((v): v is number => typeof v === 'number');
  return [...new Set(w.map(Number))].sort((a, b) => a - b);
}

function googleFamily(name: string | undefined, weights: number[]): string {
  if (!name || GENERIC.test(name)) fail(`"${name || '(empty)'}" is a generic or system font; set source.family (or typography.family) to a Google Fonts family.`);
  return `family=${encodeURIComponent(String(name)).replace(/%20/g, '+')}${weights.length ? `:wght@${weights.join(';')}` : ''}`;
}

const monoOf = (source: FontSource): MonoSource | null => (typeof source.mono === 'string' ? { family: source.mono } : source.mono ?? null);

export function fontsCss(brand?: Partial<BrandConfig> | null): string {
  const t = brand?.typography ?? {};
  const source: FontSource = t.source ?? { kind: 'none' };
  const kind: string | undefined = source.kind;
  const display = source.display ?? 'swap';
  const lines = [HEADER];
  switch (kind) {
    case 'none':
    case undefined:
      lines.push('/* typography.source.kind is "none": fonts come from the system stack, nothing to load. */');
      break;
    case 'google': {
      const resolved = resolveBrand(brand ?? undefined);
      const weights = weightsOf(source, resolved);
      const families = [googleFamily(source.family ?? firstFamily(t.family), weights)];
      const mono = monoOf(source);
      if (mono) families.push(googleFamily(mono.family, mono.weights ?? [400, 700]));
      lines.push(`@import url("https://fonts.googleapis.com/css2?${families.join('&')}&display=${encodeURIComponent(display)}");`);
      break;
    }
    case 'url': {
      const monoUrl = monoOf(source)?.url;
      const urls = [source.url, ...(monoUrl ? [monoUrl] : [])].filter((u): u is string => Boolean(u));
      if (!urls.length) fail('kind "url" needs source.url.');
      for (const u of urls) lines.push(`@import url(${quote(u)});`);
      break;
    }
    case 'local': {
      const family = source.family ?? firstFamily(t.family);
      if (!family || GENERIC.test(family)) fail('kind "local" needs source.family (the name typography.family uses).');
      const files: FontFile[] = source.files ?? (source.path ? [{ path: source.path, weight: (() => { const w = weightsOf(source, resolveBrand(brand ?? undefined)); return w.length > 1 ? `${w[0]} ${w.at(-1)}` : w[0] ?? 400; })() }] : []);
      if (!files.length) fail('kind "local" needs source.files [{ path, weight, style }] or source.path.');
      const mono = monoOf(source);
      const faces = [...files.map((f) => ({ family, ...f })), ...(mono ? (mono.files ?? []).map((f) => ({ family: mono.family, ...f })) : [])];
      for (const f of faces) {
        const fmt = formatOf(f.path);
        lines.push(
          '@font-face {',
          `  font-family: ${quote(f.family)};`,
          `  src: url(${quote(f.path)})${fmt ? ` format(${quote(fmt)})` : ''};`,
          `  font-weight: ${f.weight ?? 400};`,
          `  font-style: ${f.style ?? 'normal'};`,
          `  font-display: ${display};`,
          '}',
        );
      }
      break;
    }
    default:
      fail(`unknown kind "${kind}".`);
  }
  return lines.join('\n') + '\n';
}
