// Token build adapter (default: Style Dictionary). Swappable: it only has to turn the three
// layers into generated/css/tokens.css and pass check G1 (fresh build).
// Output: :root = first mode (all layers, as var() references); [data-theme=<mode>] and
// prefers-color-scheme blocks override only that mode's semantic tokens. Component tokens point
// at semantic variables, so they follow the mode without being repeated.
import { readFile, writeFile, mkdir, rm, mkdtemp } from 'node:fs/promises';
import { join } from 'node:path';
import { tmpdir } from 'node:os';
import StyleDictionary from 'style-dictionary';
import type { BrandConfig } from '../../generated/types/brand-config.js';
import type { HarnessConfigJson } from '../../generated/types/harness-config.js';
import { loadContracts, componentTokensFromContracts, componentTokensDoc } from '../lib/tokens.mjs';
import { parseJson, isMain } from '../lib/files.mjs';
import { modesOf } from '../standards/resolve.mjs';

export interface BuildOptions { root?: string; write?: boolean }
export interface BuildResult { css: string; componentJson: string }

// build({ root, write }): returns { css, componentJson }; writes generated/ only when write is true
// (check G1 rebuilds with write: false and compares).
export async function build({ root = process.cwd(), write = true }: BuildOptions = {}): Promise<BuildResult> {
  const config = parseJson<HarnessConfigJson>(await readFile(join(root, 'harness.config.json'), 'utf8'));
  const brand = parseJson<BrandConfig>(await readFile(join(root, 'brand.config.json'), 'utf8'));
  const prefix = config.prefix;
  const TMP = (await mkdtemp(join(tmpdir(), 'sketchbook-tokens-'))) + '/';

  const componentJson = JSON.stringify(componentTokensDoc(componentTokensFromContracts(await loadContracts(root))), null, 2) + '\n';
  const componentFile = join(TMP, 'component.tokens.json');
  await writeFile(componentFile, componentJson);

  StyleDictionary.registerTransform({
    name: 'name/sketchbook-path', type: 'name',
    transform: (token) => `${prefix}-${token.path.join('-')}`,
  });

  const blocks: string[] = [];
  for (const [i, { name: mode, role }] of modesOf(brand).entries()) {
    const first = i === 0;
    const sd = new StyleDictionary({
      log: { verbosity: 'silent', warnings: 'disabled' },
      source: [
        join(root, 'spec/tokens/foundation/*.tokens.json'),
        join(root, 'spec/tokens/semantic/base.tokens.json'),
        join(root, `spec/tokens/semantic/${mode}.tokens.json`),
        componentFile,
      ],
      platforms: {
        css: {
          transforms: ['name/sketchbook-path', 'color/css', 'fontFamily/css', 'cubicBezier/css', 'shadow/css/shorthand'],
          buildPath: TMP,
          files: [{
            destination: `${mode}.css`,
            format: 'css/variables',
            filter: first ? undefined : (token) => token.filePath.includes(`semantic/${mode}.tokens.json`),
            options: { outputReferences: true, selector: '__SELECTOR__', showFileHeader: false },
          }],
        },
      },
    });
    await sd.buildAllPlatforms();
    const body = (await readFile(join(TMP, `${mode}.css`), 'utf8')).trim();
    if (first) blocks.push(body.replace('__SELECTOR__', `:root, [data-theme="${mode}"]`));
    else {
      blocks.push(body.replace('__SELECTOR__', `[data-theme="${mode}"]`));
      if (role === 'dark') {
        const inner = body.replace('__SELECTOR__', ':root:not([data-theme])').split('\n').map((l) => `  ${l}`).join('\n');
        blocks.push(`@media (prefers-color-scheme: dark) {\n${inner}\n}`);
      }
    }
  }
  await rm(TMP, { recursive: true, force: true });
  const header = `/* GENERATED by harness/build/tokens.mjs from spec/tokens and each spec/components/<name>/contract.json. Do not edit. */`;
  const css = `${header}\n${blocks.join('\n\n')}\n`;
  if (write) {
    await mkdir(join(root, 'generated/css'), { recursive: true });
    await mkdir(join(root, 'generated/tokens'), { recursive: true });
    await writeFile(join(root, 'generated/css/tokens.css'), css);
    await writeFile(join(root, 'generated/tokens/component.tokens.json'), componentJson);
  }
  return { css, componentJson };
}

if (isMain(import.meta.url)) {
  build().then(({ css }) => console.log(`tokens.css: ${css.split('\n').filter((l) => l.trim().startsWith('--')).length} variables`)).catch((e) => { console.error(e); process.exit(1); });
}
