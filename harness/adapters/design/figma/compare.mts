// Figma design adapter, compare: a read-only use_figma script per pattern. It carries the Storybook inventory of each
// state and the diff function of harness/lib/design/compare.mjs, reads the visible texts of the drawn screens, and
// returns only the difference rows, so what comes back is small and the diff has one implementation.
import { patternOf, PATTERNS_PAGE } from '../../../lib/design/patterns.mjs';
import { TOLERANCE, diffInventories, norm, readInventory, stateTitle } from '../../../lib/design/compare.mjs';
import type { Inventory } from '../../../lib/design/compare.mjs';

const RUNTIME = `const page = figma.root.children.find((p) => p.name === cfg.page);
if (!page) return [{ id: cfg.id, error: 'no page ' + cfg.page }];
await figma.setCurrentPageAsync(page);
const collect = (node, origin, texts) => {
  if (!node.visible) return;
  if (node.type === 'TEXT') {
    const b = node.absoluteBoundingBox;
    if (b && node.characters.trim() && b.width > 2 && b.height > 2) texts.push({ t: node.characters.replace(/\\s+/g, ' ').trim(), x: Math.round(b.x - origin.x), y: Math.round(b.y - origin.y), w: Math.round(b.width), h: Math.round(b.height), a: node.textAlignHorizontal });
    return;
  }
  if ('children' in node) for (const c of node.children) collect(c, origin, texts);
};
const rows = [];
const doc = page.children.find((n) => n.type === 'FRAME' && n.name === cfg.doc);
if (!doc) return [{ id: cfg.id, error: 'doc not drawn' }];
const body = doc.children.find((n) => n.name === 'Body');
for (const state of cfg.states) {
  const section = body && body.children.find((s) => s.name === 'Section' && (s.children.find((n) => n.name === 'SectionTitle') || {}).characters === state.title);
  const screen = section && section.findOne((n) => n.name === 'Screen');
  if (!screen) { rows.push({ id: cfg.id, state: state.id, error: 'screen not drawn' }); continue; }
  const texts = [];
  collect(screen, screen.absoluteBoundingBox, texts);
  rows.push({ id: cfg.id, state: state.id, ...diffInventories(cfg.sb[state.id], { texts }) });
}
return rows;
`;

export async function compareScript(root: string, id: string): Promise<string> {
  const p = await patternOf(root, id);
  const sb: Record<string, Inventory | null> = {};
  for (const state of p.states) {
    sb[state.toString()] = await readInventory(root, id, state);
    if (!sb[state]) throw Object.assign(new Error(`No Storybook inventory for ${id}/${state}.`), { fix: 'Run sketchbook sync compare <pattern> against a running Storybook first.' });
  }
  const cfg = { page: PATTERNS_PAGE, id, doc: p.name, states: p.states.map((s) => ({ id: s, title: stateTitle(s) })), sb };
  return `// GENERATED by sketchbook sync compare (read-only). Run with the Figma MCP use_figma tool; save what it returns to generated/design/compare/${id}.fg.json.\nconst cfg = ${JSON.stringify(cfg)};\nconst TOLERANCE = ${TOLERANCE};\nconst norm = ${norm.toString()};\nconst diffInventories = ${diffInventories.toString()};\n${RUNTIME}`;
}
