// Figma design adapter, icons: spec/icons.json -> use_figma scripts that draw one component set per icon on the Icons
// page, named "category / name", with a Size variant per size.icon.* token. Width and height are bound to that token,
// the stroke to the foreground color, the grid gap and padding to space tokens. An icon already on the page is kept.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { loadIcons, svgOf } from '../../../lib/icons.mjs';
import { parseJson } from '../../../lib/files.mjs';
import type { HarnessConfigJson } from '../../../../generated/types/harness-config.js';
import { figmaModel } from './variables.mjs';
import { ZERO_RUNTIME, zeroVars } from './zero.mjs';

export const ICON_PAGE = 'Icons';
export const ICON_GRID = 'Icon library';
const SIZES = ['sm', 'default', 'lg', 'xl'];
const TOKENS: Record<string, string> = { fg: 'color.foreground', fill: 'color.muted', radius: 'radius.small', pad: 'space.inset.spacious', gap: 'space.stack.md', ...Object.fromEntries(SIZES.map((s) => [s, `size.icon.${s}`])) };
const BATCH = 40;

// The first script draws one icon, to be checked by eye before the rest.
export async function iconScripts(root: string): Promise<string[]> {
  const model = await figmaModel(root);
  const byToken = new Map(model.collections.flatMap((c) => c.variables.map((v) => [v.token, `${c.name}::${v.name}`])));
  const vars = Object.fromEntries(Object.entries(TOKENS).map(([k, t]) => [k, byToken.get(t)]));
  const missing = Object.entries(TOKENS).filter(([k]) => !vars[k]).map(([, t]) => t);
  if (missing.length) throw Object.assign(new Error(`Tokens not in the design model: ${missing.join(', ')}.`), { fix: 'sketchbook sync tokens first.' });
  const Z = zeroVars(model);
  const docs = parseJson<HarnessConfigJson>(await readFile(join(root, 'harness.config.json'), 'utf8')).adapters.design.docs;
  if (!docs) throw new Error('harness.config.json: adapters.design.docs.width is not set.');
  const width = docs.width;
  const icons = Object.entries(loadIcons(root).icons).map(([name, i]) => {
    if (!i.nodes) throw new Error(`spec/icons.json: ${name} has no drawing (nodes).`);
    return { name, category: i.category, aliases: i.aliases, svg: svgOf(i.nodes) };
  });
  const groups = [icons.slice(0, 1)];
  for (let i = 1; i < icons.length; i += BATCH) groups.push(icons.slice(i, i + BATCH));
  return groups.filter((g) => g.length).map((g) => `// GENERATED by sketchbook sync icons. Run with the Figma MCP use_figma tool.
const cfg = ${JSON.stringify({ page: ICON_PAGE, grid: ICON_GRID, width, sizes: SIZES, vars, Z, icons: g })};
${RUNTIME}`);
}

const RUNTIME = `const report = { created: [], kept: [], errors: [], missing: [] };
${ZERO_RUNTIME}const page = figma.root.children.find((p) => p.name === cfg.page);
if (!page) throw new Error('No page "' + cfg.page + '": run sketchbook sync pages first.');
await figma.setCurrentPageAsync(page);
const V = figma.variables;
const cols = Object.fromEntries((await V.getLocalVariableCollectionsAsync()).map((c) => [c.id, c.name]));
const byKey = new Map((await V.getLocalVariablesAsync()).map((v) => [cols[v.variableCollectionId] + '::' + v.name, v]));
const variable = (k) => { const v = byKey.get(cfg.vars[k]); if (!v) report.missing.push(k); return v; };
const paint = (k) => { const v = variable(k); return v ? [V.setBoundVariableForPaint({ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', v)] : []; };
const bind = (node, k, fields) => { const v = variable(k); if (v) for (const f of fields) node.setBoundVariable(f, v); };
const PAD = ['paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft'];

let grid = page.children.find((n) => n.type === 'FRAME' && n.name === cfg.grid);
if (!grid) {
  grid = figma.createAutoLayout('HORIZONTAL');
  grid.name = cfg.grid; grid.fills = []; grid.layoutWrap = 'WRAP';
  grid.resize(cfg.width, grid.height); grid.primaryAxisSizingMode = 'FIXED'; grid.counterAxisSizingMode = 'AUTO';
  bind(grid, 'pad', PAD); bind(grid, 'gap', ['itemSpacing', 'counterAxisSpacing']);
  page.appendChild(grid);
}
const px = {};
for (const s of cfg.sizes) { const v = variable(s); px[s] = v ? v.resolveForConsumer(grid).value : null; }

for (const icon of cfg.icons) {
  const name = icon.category + ' / ' + icon.name;
  if (grid.children.some((c) => c.name === name)) { report.kept.push(name); continue; }
  try {
    const made = [];
    for (const s of cfg.sizes) {
      const n = px[s];
      const frame = figma.createNodeFromSvg('<svg xmlns="http://www.w3.org/2000/svg" width="' + n + '" height="' + n + '" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + icon.svg + '</svg>');
      const vec = figma.flatten(frame.children);
      vec.name = 'Vector'; vec.fills = []; vec.strokes = paint('fg'); vec.strokeWeight = 2 * n / 24; vec.strokeCap = 'ROUND'; vec.strokeJoin = 'ROUND';
      vec.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };
      const comp = figma.createComponentFromNode(frame);
      comp.name = 'Size=' + s; comp.fills = []; comp.clipsContent = false;
      bind(comp, s, ['width', 'height']);
      made.push(comp);
    }
    const set = figma.combineAsVariants(made, grid);
    set.name = name;
    set.layoutMode = 'VERTICAL'; set.primaryAxisSizingMode = 'AUTO'; set.counterAxisSizingMode = 'AUTO'; set.counterAxisAlignItems = 'CENTER';
    set.fills = paint('fill'); set.strokes = [];
    bind(set, 'pad', PAD); bind(set, 'gap', ['itemSpacing']); bind(set, 'radius', ['topLeftRadius', 'topRightRadius', 'bottomRightRadius', 'bottomLeftRadius']);
    const md = '**' + name + '**\\n\\nAliases: ' + icon.aliases.join(', ') + '\\n\\nLucide: ' + icon.name + ' (ISC)';
    set.descriptionMarkdown = md;
    for (const c of set.children) c.descriptionMarkdown = md;
    report.created.push(name + ' [' + set.children.map((c) => c.name + ' ' + Math.round(c.width)).join(', ') + ']');
  } catch (e) { report.errors.push(name + ': ' + e.message); }
}
report.zeros = await bindZeros(grid);
return report;
`;
