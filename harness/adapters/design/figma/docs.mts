  const width = spanPx(c.span || C.span, inner);
  const w = width - 2 * cfg.px.cardPad;
  if (c.type === 'tree') {
    const t = box('Tree', { gap: S.tree.node.gap, width });
    for (const r of c.roots) { const n = await treeNode(r, 0, width); t.appendChild(n); fillW(n); }
    return t;
  }
  const names = { instruction: 'InstructionCard', specimen: 'SpecimenCard', table: 'Table', matrix: 'MatrixCard', preview: 'PreviewFrame', code: 'CodeBlock', tags: 'TagGroup' };
  const k = box(names[c.type] || 'Card', { fill: c.type === 'specimen' ? (c.surface ? C.surface : null) : C.fill || S.cards.instruction.fill, stroke: C.stroke || S.cards.instruction.stroke, strokeWidth: C.strokeWidth || S.cards.instruction.strokeWidth, radius: C.radius || S.cards.instruction.radius, pad: C.pad || S.cards.instruction.pad, gap: C.gap || S.cards.instruction.gap, width });
  if (c.title) { const t = await text(c.title, { name: 'Title', size: (C.title || S.cards.specimen.title).size, color: (C.title || S.cards.specimen.title).color, width: w }); k.appendChild(t); fillW(t); }
