}
`;

export const RUNTIME = `${HELPERS}async function draw(d) {
  for (const n of page.children.filter((n) => n.name === d.name && n.type === 'FRAME').slice(1)) n.remove();
  const old = page.children.find((n) => n.name === d.name && n.type === 'FRAME');
  const at = old ? { x: old.x, y: old.y } : { x: page.children.reduce((m, n) => Math.max(m, n.x + n.width + cfg.px.docGap), 0), y: 0 };
  if (old) old.remove();
  const doc = docFrame(d.name);
  doc.x = at.x; doc.y = at.y;
  page.appendChild(doc);
  const h = await cover(doc, d);
  const body = box('Body', { pad: S.body.pad, gap: S.body.gap });
  doc.appendChild(body); fillW(body);
  for (const sec of d.sections) {
    const s = box('Section', { gap: S.section.gap });
    body.appendChild(s); fillW(s);
    if (sec.title) { const t = await text(sec.title, { name: 'SectionTitle', size: S.section.title.size, color: S.section.title.color, width: inner }); s.appendChild(t); fillW(t); }
    const row = box('Cards', { dir: 'row', wrap: true, gapPx: cfg.px.gutter });
    s.appendChild(row); fillW(row);
    for (const c of sec.cards) row.appendChild(await card(c));
  }
  rings(h);
  report.zeros += await bindZeros(doc);
  report.docs.push({ name: d.name, id: doc.id, size: [Math.round(doc.width), Math.round(doc.height)] });
}
for (const d of cfg.docs || [cfg.doc]) await draw(d);
return report;
`;

// The Theme matrix page: the doc header, then one row per drawn set (its name and representative variants) with one
// cell per column; a cell pins every theme axis collection to its column's modes (the Live column pins none), so rows
// stay aligned whatever the density. Rows are split over several pastes; the first draws the header and the column
// heads, the next ones append their rows. A read-only script reads the pins and the instances back.
interface MatrixShell {
  doc: { fill: string }; sample: { gap: string }; section: { gap: string };
  cards: { instruction: { pad: string; radius: string; stroke: string; strokeWidth: string } };
}
const MATRIX_CELLS_PER_PASTE = 18;
// Pagination at Spacious density (368) plus the cell padding; anything wider spills out of its column.
const MATRIX_CELL_WIDTH = 416;
const MATRIX_LABEL_WIDTH = 240;
export const sumOf = (s: string): number => { let h = 5381; for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) | 0; return h; };
export const SUM = 'const sumOf = (s) => { let h = 5381; for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) | 0; return h; };\n';

// A Components page: one doc per component of the batch, left to right, docs grouped into pastes under the use_figma
// code limit, each checksum-guarded. A read-only script reads back every grid cell and preview instance by variant name.
export const PASTE_LIMIT = 48000;
// Columns per band of a doc grid: as many as keep the widest variant inside its cell padding (the runtime's grid widths);
// the grid wraps into bands of that many columns, each with its own head row, so no example is shrunk or cropped.
export function matrixColumns(n: number, minWidth: number | undefined, px: { width: number; docPad: number; cardPad: number; line: number; matrixPad: number }): number {
  const w = px.width - 2 * px.docPad - 2 * px.cardPad, labelW = Math.round(w / 6);
  const room = (k: number) => Math.floor((w - labelW - k * px.line) / k) - 2 * px.matrixPad;
  let k = n;
  while (k > 1 && minWidth !== undefined && room(k) < minWidth) k--;
  return k;
}
export async function componentScripts(root: string, id: string): Promise<DocFile[]> {
  const spec = docsSpec(root);
  const batches = spec.batches ?? [];
  const batch = batches.find((b) => b.id === id);
  if (!batch) throw Object.assign(new Error(`No batch "${id}".`), { fix: `Batches: ${batches.map((b) => b.id).join(', ')} (spec/design-docs.json).` });
  const model = await figmaModel(root);
  const page = componentPage(spec, batch.components[0] ?? '');
  const base = await docsData(root, page, {});
  const docs: DrawnDoc[] = [];
  for (const name of batch.components) {
    const d = await componentDoc(root, name);
    const cardOf = (card: DocCard): DrawnCard => { if (card.type !== 'matrix') return card; const { minWidth, ...c } = card; const per = matrixColumns(c.cols.length, minWidth, base.px); return per < c.cols.length ? { ...c, per } : c; };
    docs.push({ ...d, sections: d.sections.map((s) => ({ ...s, cards: s.cards.map(cardOf) })) });
  }
  const config = parseJson<HarnessConfigJson>(await readFile(join(root, 'harness.config.json'), 'utf8'));
  base.codeFamilies = [designFamily(base.codeFamilies, designFonts(config))];
  const scriptOf = (g: DrawnDoc[], i: number, n: number): DocFile => {
    const { doc: _doc, ...rest } = base;
    const data = { ...rest, docs: g };
    const shell = Object.fromEntries(SHELL_PARTS.filter((k) => data.shell[k]).map((k) => [k, data.shell[k]]));
    const { pages: _pages, textStyles: _textStyles, ...kept } = data;
    // Text roles by style and effect styles serve foundation specimens only.
    const { textByToken: _textByToken, effects: _effects, ...look } = lookups(model, { ...data, shell });
    const cfg = { ...kept, shell, ...look, sum: sumOf(JSON.stringify([g, look.Z])) };
    const names = g.map((d) => d.name);
    return { file: `components-${id}-${i + 1}.js`, names, script: `// GENERATED by sketchbook sync components ${id} (part ${i + 1} of ${n}: ${names.join(', ')}). Run with the Figma MCP use_figma tool, parts in order.\nconst cfg = ${JSON.stringify(cfg)};\n${SUM}if (sumOf(JSON.stringify([cfg.docs, cfg.Z])) !== cfg.sum) throw new Error('This script was altered when pasted (checksum mismatch); paste the file exactly.');\n${RUNTIME}` };
  };
  // Docs are packed by the length of the script they make, so each paste carries as many docs as the limit allows.
  const groups: DrawnDoc[][] = [];
  for (const d of docs) {
    const last = groups.at(-1);
    if (last && scriptOf([...last, d], 0, 99).script.length <= PASTE_LIMIT) last.push(d); else groups.push([d]);
  }
  const scripts = groups.map((g, i) => scriptOf(g, i, groups.length));
  const banded = (c: BandedMatrix) => { const per = c.per || c.cols.length, out: unknown[] = []; for (let s = 0; s < c.cols.length; s += per) for (const r of c.rows) out.push(...r.cells.slice(s, s + per)); return out; };
  const cards = (d: DrawnDoc) => d.sections.flatMap((s) => s.cards.flatMap((c) => (c.type === 'matrix' || c.type === 'preview' ? [{ section: s.title, set: c.set, cells: c.type === 'matrix' ? banded(c) : c.items }] : [])));
  const verified = { page, docs: docs.map((d) => ({ name: d.name, sections: d.sections.map((s) => s.title), cards: cards(d) })) };
  const expected = { ...verified, sum: sumOf(JSON.stringify(verified)) };
  scripts.push({ file: `components-${id}-verify.js`, names: [], script: `// GENERATED by sketchbook sync components ${id} (read-only read-back). Run with the Figma MCP use_figma tool.\nconst cfg = ${JSON.stringify(expected)};\n${SUM}${COMPONENTS_VERIFY}` });
  return scripts;
}

const COMPONENTS_VERIFY = `if (sumOf(JSON.stringify({ page: cfg.page, docs: cfg.docs })) !== cfg.sum) throw new Error('This script was altered when pasted (checksum mismatch); paste the file exactly.');
const page = figma.root.children.find((p) => p.name === cfg.page);
if (!page) return { ok: false, problems: ['no page "' + cfg.page + '"'] };
await figma.setCurrentPageAsync(page);
const problems = [];
let instances = 0;
const nameOf = async (i) => { const m = await i.getMainComponentAsync(); if (!m) return ['?', '?']; return m.parent && m.parent.type === 'COMPONENT_SET' ? [m.parent.name, m.name] : [m.name, m.name]; };
for (const d of cfg.docs) {
  const doc = page.children.find((n) => n.type === 'FRAME' && n.name === d.name);
  if (!doc) { problems.push(d.name + ': doc missing'); continue; }
  const body = doc.children.find((n) => n.name === 'Body');
  const sections = body ? body.children.filter((n) => n.name === 'Section') : [];
  const titles = sections.map((s) => (s.children.find((n) => n.name === 'SectionTitle') || {}).characters);
  if (JSON.stringify(titles) !== JSON.stringify(d.sections)) problems.push(d.name + ': sections ' + titles.join(', ') + ', expected ' + d.sections.join(', '));
  const queue = {};
  for (const s of sections) {
    const t = (s.children.find((n) => n.name === 'SectionTitle') || {}).characters;
    const row = s.children.find((n) => n.name === 'Cards');
    queue[t] = row ? row.children.filter((n) => n.name === 'MatrixCard' || n.name === 'PreviewFrame') : [];
  }
  for (const c of d.cards) {
    const card = (queue[c.section] || []).shift();
    if (!card) { problems.push(d.name + ' / ' + c.section + ': card missing'); continue; }
    const got = [];
    if (card.name === 'MatrixCard') {
      const g = card.children.find((n) => n.name === 'Grid');
      for (const r of (g ? g.children : []).filter((n) => n.name !== 'Head')) for (const x of r.children.filter((n) => n.name === 'Cell' || n.name === 'Excluded')) got.push(x.name === 'Excluded' ? null : x.children.find((n) => n.type === 'INSTANCE') || 'empty');
    } else { const sm = card.children.find((n) => n.name === 'Samples'); for (const x of sm ? sm.children : []) got.push(x); }
    if (got.length !== c.cells.length) { problems.push(d.name + ' / ' + c.section + ': ' + got.length + ' cells, expected ' + c.cells.length); continue; }
    for (let i = 0; i < c.cells.length; i++) {
      const want = c.cells[i], have = got[i];
      if (want === null) { if (have !== null) problems.push(d.name + ' / ' + c.section + ' #' + (i + 1) + ': expected not available'); continue; }
      if (!have || have === 'empty' || have.type !== 'INSTANCE') { problems.push(d.name + ' / ' + c.section + ' #' + (i + 1) + ': no instance of ' + want); continue; }
      const [set, variant] = await nameOf(have);
      instances++;
      if (set !== c.set || variant !== want) problems.push(d.name + ' / ' + c.section + ' #' + (i + 1) + ': ' + set + ' ' + variant + ', expected ' + want);
    }
  }
}
return { ok: !problems.length, docs: cfg.docs.length, instances, problems: problems.slice(0, 20), more: Math.max(0, problems.length - 20) };
`;

export async function themeMatrixScripts(root: string, names: string[]): Promise<(Omit<DocFile, 'names'> & { rows: string[] })[]> {
  const model = await figmaModel(root);
  const m = await themeMatrixDoc(root, names);
  const last = m.columns.at(-1);
  if (!last) throw new Error('The theme matrix has no columns.');
  const groups = Object.keys(last.modes);
  const axes = groups.map((group) => {
    const values = [...new Set(m.columns.map((c) => c.modes[group]).filter((v): v is string => Boolean(v)))];
    const c = model.collections.find((x) => values.every((v) => x.modes.includes(v)));
    if (!c) throw new Error(`No variable collection has the ${group} modes ${values.join(', ')}.`);
    return { group, collection: c.name };
  });
  const base = await docsData(root, 'Theme matrix', {});
  const S = docsSpec<{ shell: MatrixShell }>(root).shell;
  const tokens = { cellFill: S.doc.fill, cellPad: S.cards.instruction.pad, cellGap: S.sample.gap, cellRadius: S.cards.instruction.radius, cellStroke: S.cards.instruction.stroke, cellStrokeWidth: S.cards.instruction.strokeWidth, colGap: S.sample.gap, rowGap: S.section.gap };
  const width = 2 * base.px.docPad + MATRIX_LABEL_WIDTH + m.columns.length * (MATRIX_CELL_WIDTH + base.px.sampleGap);
  const chunks: ThemeMatrixDoc['rows'][] = [];
  let cur: ThemeMatrixDoc['rows'] = [];
  for (const r of m.rows) {
    if (cur.length && cur.reduce((n, x) => n + x.cells.length, 0) + r.cells.length > MATRIX_CELLS_PER_PASTE) { chunks.push(cur); cur = []; }
    cur.push(r);
  }
  if (cur.length) chunks.push(cur);
  const scripts = chunks.map((rows, i) => {
    const doc = { name: m.name, link: m.link, definition: m.definition, columns: m.columns, rows, tokens };
    const data = { ...base, doc, px: { ...base.px, width, cellWidth: MATRIX_CELL_WIDTH, labelWidth: MATRIX_LABEL_WIDTH } };
    const shell = Object.fromEntries(SHELL_PARTS.filter((k) => data.shell[k]).map((k) => [k, data.shell[k]]));
    const { pages: _pages, textStyles: _textStyles, ...kept } = data;
    const body = { ...kept, shell, ...lookups(model, { ...data, shell }), axes, part: i + 1, parts: chunks.length };
    const cfg = { ...body, sum: sumOf(JSON.stringify([body.doc, body.axes, body.part, body.Z])) };
    return { file: `theme-matrix-${i + 1}.js`, rows: rows.map((r) => r.title), script: `// GENERATED by sketchbook sync theme-matrix (part ${i + 1} of ${chunks.length}: ${rows.map((r) => r.title).join(', ')}). Run with the Figma MCP use_figma tool, parts in order.\nconst cfg = ${JSON.stringify(cfg)};\n${SUM}${MATRIX_GUARD}${HELPERS}${MATRIX}` };
  });
  const verified = { page: 'Theme matrix', name: m.name, columns: m.columns, axes, rows: m.rows.map((r) => [r.title, r.cells.length]) };
  const expected = { ...verified, sum: sumOf(JSON.stringify(verified)) };
  scripts.push({ file: 'theme-matrix-verify.js', rows: [], script: `// GENERATED by sketchbook sync theme-matrix (read-only read-back). Run with the Figma MCP use_figma tool.\nconst cfg = ${JSON.stringify(expected)};\n${SUM}${MATRIX_VERIFY}` });
  return scripts;
}

const MATRIX_GUARD = `if (sumOf(JSON.stringify([cfg.doc, cfg.axes, cfg.part, cfg.Z])) !== cfg.sum) throw new Error('This script was altered when pasted (checksum mismatch); paste the file exactly.');
`;

const MATRIX = `const M = cfg.doc, T = M.tokens;
const axes = cfg.axes.map((a) => ({ ...a, col: collections.find((c) => c.name === a.collection) }));
const pinCell = (node, modes) => {
