    const nums = await text(c.source.map((_, i) => i + 1).join('\\n'), { name: 'Numbers', size: X.value.size, color: X.num.color, width: cfg.px.codeNum });
    const code = await text(c.source.join('\\n'), { name: 'Code', size: X.value.size, color: X.value.color });
    if (f) { nums.fontName = f; code.fontName = f; }
    const starts = c.source.reduce((acc, l) => acc.concat(acc.at(-1) + l.length + 1), [0]);
    for (const [line, a, b] of c.marks || []) code.setRangeFills(starts[line] + a, starts[line] + b, paint(X.highlight));
    src.appendChild(nums); src.appendChild(code);
  }
  if (c.type === 'tags') {
    const row = box('Tags', { dir: 'row', wrap: true, gap: S.tag.gap });
    k.appendChild(row); fillW(row);
    for (const it of c.items) row.appendChild(await pill(it.label, it.value, it.token));
  }
