const problems = [];
const modesOf = (node) => Object.fromEntries(Object.entries(node.explicitVariableModes || {}).map(([cid, mid]) => { const c = cols[cid]; return [c ? c.name : cid, c ? (c.modes.find((m) => m.modeId === mid) || {}).name : mid]; }));
for (const [title, n] of cfg.rows) {
