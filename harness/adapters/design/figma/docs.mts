    const T = S.cards.instruction.text;
    const list = box('Lines', { gap: S.cards.instruction.lines.gap });
    k.appendChild(list); fillW(list);
    for (const line of c.lines) {
      const t = await text(line, { name: 'Line', size: T.size, color: T.color, width: w });
      const target = c.linkTo === 'page' && figma.root.children.find((p) => p.name === line);
      if (target) { t.setRangeHyperlink(0, t.characters.length, { type: 'NODE', value: target.id }); report.links++; }
