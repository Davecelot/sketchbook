    const n = c.columns.length, g = cfg.px.sampleGap, ws = c.widths || c.columns.map(() => 1), sum = ws.reduce((a, b) => a + b, 0);
    const widthOf = (i) => Math.floor(((w - (n - 1) * g) * ws[i]) / sum);
    const rows = box('Rows', { gap: S.sample.gap });
    k.appendChild(rows); fillW(rows);
    const head = box('Head', { dir: 'row', gap: S.sample.gap });
    rows.appendChild(head); fillW(head);
    for (const [i, col] of c.columns.entries()) head.appendChild(await text(col, { name: 'Column', size: S.matrix.head.text.size, color: S.caption.color, width: widthOf(i) }));
    for (const r of c.rows) {
      const row = box('Row', { dir: 'row', gap: S.sample.gap, center: !c.widths });
