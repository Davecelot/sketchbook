// Figma design adapter, docs: a doc blueprint (harness/lib/design/docs.mjs) + the doc shell (spec/design-docs.json) ->
// one use_figma script that draws the doc on its page with every fill, stroke, radius, gap and padding bound to a
// variable and every text on a text style. A rebuild replaces the doc of the same name in place; nothing else moves.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { componentDoc, componentPage, docsData, foundationDoc, guideDoc, themeMatrixDoc } from '../../../lib/design/docs.mjs';
import type { ThemeMatrixDoc } from '../../../lib/design/docs.mjs';
import { loadDesignDocs, DOCS_FILE } from '../../../lib/design-docs.mjs';
import type { DesignDocsSpec, DocShell } from '../../../lib/design-docs.mjs';
import type { DocBlueprint, DocCard, MatrixCard } from '../../../lib/design/doc-text.mjs';
import { parseJson } from '../../../lib/files.mjs';
import type { HarnessConfigJson } from '../../../../generated/types/harness-config.js';
import { designFamily, designFonts, figmaModel } from './variables.mjs';
import type { FigmaModel } from './variables.mjs';
import { ZERO_RUNTIME, zeroVars } from './zero.mjs';
import type { ZeroVars } from './zero.mjs';

export type DocsData<D> = Awaited<ReturnType<typeof docsData<D>>>;
export interface Lookups { vars: Record<string, string>; styles: Record<string, string | undefined>; textByToken: Record<string, string>; effects: Record<string, string>; modeAxis: { collection: string; modes: Record<string, string> } | null; Z: ZeroVars }
export interface FoundationGroup { names: string[]; docs: DocBlueprint[]; script: string }
export interface DocFile { file: string; names: string[]; script: string }
type BandedMatrix = Omit<MatrixCard, 'minWidth'> & { per?: number };
type DrawnCard = Exclude<DocCard, MatrixCard> | BandedMatrix;
interface DrawnDoc extends Omit<DocBlueprint, 'sections'> { sections: { title?: string; cards: DrawnCard[] }[] }

// spec/design-docs.json read as the shape a caller needs; check D3 validates the file.
export const docsSpec = <T extends object = DesignDocsSpec>(root: string): T => {
  const spec = loadDesignDocs<T>(root);
  if (!spec) throw new Error(`${DOCS_FILE} is missing or not valid JSON.`);
  return spec;
};

// The variables and text styles a doc names: token path -> "Collection::Name", text role -> style name.
export function lookups(model: FigmaModel, cfg: { shell: unknown; doc?: unknown; docs?: unknown; textStyles: Record<string, string> }): Lookups {
  const byToken = new Map(model.collections.flatMap((c) => c.variables.map((v) => [v.token, `${c.name}::${v.name}`])));
  const vars: Record<string, string> = {};
  const walk = (n: unknown): void => {
    if (typeof n === 'string') { const v = byToken.get(n); if (v !== undefined) vars[n] = v; }
    else if (Array.isArray(n)) n.forEach(walk);
    else if (n && typeof n === 'object') Object.values(n).forEach(walk);
  };
  walk(cfg.shell);
  walk(cfg.doc);
  walk(cfg.docs);
  const styles = Object.fromEntries(Object.entries(cfg.textStyles).map(([size, role]): [string, string | undefined] => [size, model.styles.text.find((t) => t.token === role)?.name]).filter(([, n]) => n));
  const textByToken = Object.fromEntries(model.styles.text.map((t) => [t.token, t.name]));
  const effects = Object.fromEntries(model.styles.effect.map((e) => [e.token, e.name]));
  const axis = model.collections.find((c) => c.name === 'Semantic - Color');
  const modeAxis = axis ? { collection: axis.name, modes: Object.fromEntries(axis.modes.map((m) => [m.toLowerCase(), m])) } : null;
  return { vars, styles, textByToken, effects, modeAxis, Z: zeroVars(model) };
}

// The brand mark as one component on the Guide page; every doc header draws an instance of it. The script creates the
// empty component (a vector mark is too big for a use_figma script); the file itself goes in through upload_assets, then
// a second script moves the imported vector into the component with scale constraints.
export async function brandScript(root: string): Promise<string> {
  const { logo } = docsSpec<{ shell: { header: { logo: { image: string; page: string; component: string } } } }>(root).shell.header;
  if (!(await readFile(join(root, logo.image)).then(() => true, () => false))) {
    throw Object.assign(new Error(`No brand mark at ${logo.image}.`), { fix: `Add the file there (spec/design-docs.json, shell.header.logo.image) or remove logo.component.` });
  }
  return `// GENERATED by sketchbook sync brand. Run with the Figma MCP use_figma tool.
// Then upload ${logo.image} (upload_assets, image/svg+xml, current page ${logo.page}) and move the imported vector into the component.
const page = figma.root.children.find((p) => p.name === ${JSON.stringify(logo.page)});
if (!page) throw new Error('No page "${logo.page}": run sketchbook sync pages first.');
await figma.setCurrentPageAsync(page);
let mark = page.children.find((n) => n.type === 'COMPONENT' && n.name === ${JSON.stringify(logo.component)});
const created = !mark;
if (created) { mark = figma.createComponent(); mark.name = ${JSON.stringify(logo.component)}; mark.resize(120, 120); mark.x = -240; mark.y = 0; mark.fills = []; }
return { created, id: mark.id, page: page.name };
`;
}

export async function guideScript(root: string): Promise<string> {
  const model = await figmaModel(root);
  const collections = model.collections.map((c) => ({ name: c.name, modes: c.modes, count: c.variables.length }));
  return docScript(model, await docsData(root, 'Guide', await guideDoc(root, { collections })));
}

// The Foundations page: one doc per foundation, left to right. Docs are grouped into scripts that stay under the
// use_figma code limit (50,000 characters).
export async function foundationScripts(root: string, pages: string[]): Promise<FoundationGroup[]> {
  const model = await figmaModel(root);
  const groups: DocsData<DocBlueprint>[][] = [];
  let cur: DocsData<DocBlueprint>[] = [];
  const PART_LIMIT = 14000;
  for (const page of pages) {
    const whole = await docsData(root, 'Foundations', await foundationDoc(root, page));
    // A doc too big for one script is split by section, one doc per section, so each part stays under the limit.
    const parts = JSON.stringify(whole.doc).length <= PART_LIMIT ? [whole] : whole.doc.sections.map((s) => ({ ...whole, doc: { ...whole.doc, name: `${whole.doc.name}: ${(s.title ?? '').toLowerCase()}`, sections: [s] } }));
    for (const data of parts) {
      const next = [...cur, data];
      if (cur.length && JSON.stringify(next.map((d) => d.doc)).length > PART_LIMIT) { groups.push(cur); cur = [data]; } else cur = next;
    }
  }
  if (cur.length) groups.push(cur);
  return groups.map((g) => {
    const [head] = g;
    if (!head) throw new Error('An empty group of foundation docs.');
    const { doc: _doc, ...first } = head;
    const cfg = { ...first, docs: g.map((d) => d.doc) };
    return { names: g.map((d) => d.doc.name), docs: g.map((d) => d.doc), script: docScript(model, cfg) };
  });
}

// Read-only read-back of the Foundations page: every doc the draw scripts make is there, with its section titles, and
// no other doc frame is left over (SB-0091 pattern). Returns what it found; nothing is written.
export function foundationsVerifyScript(groups: Pick<FoundationGroup, 'docs'>[]): string {
  const expected = groups.flatMap((g) => g.docs).map((d) => ({ name: d.name, sections: d.sections.map((x) => x.title).filter(Boolean) }));
  return `// GENERATED by sketchbook sync foundations. Read-only: run with the Figma MCP use_figma tool; save what it returns.
const expected = ${JSON.stringify(expected)};
const page = figma.root.children.find((p) => p.name === 'Foundations');
if (!page) return { error: 'No page "Foundations": run sketchbook sync pages first.' };
await page.loadAsync();
const frames = page.children.filter((n) => n.type === 'FRAME');
const docs = [];
const missing = [];
for (const e of expected) {
  const f = frames.find((n) => n.name === e.name);
  if (!f) { missing.push(e.name); continue; }
  const titles = f.findAll((n) => n.type === 'TEXT' && n.name === 'SectionTitle').map((n) => n.characters);
  docs.push({ name: e.name, id: f.id, sections: titles.length, absentSections: e.sections.filter((t) => !titles.includes(t)) });
}
const names = new Set(expected.map((e) => e.name));
return { page: 'Foundations', docs, missing, leftover: frames.filter((n) => !names.has(n.name)).map((n) => n.name) };`;
}

// The shell parts the runtime draws (the rest of spec/design-docs.json serves other doc kinds).
export const SHELL_PARTS = ['doc', 'header', 'body', 'section', 'cards', 'sample', 'caption', 'tag', 'matrix', 'tree', 'code'];
export function docScript<T extends { shell: DocShell; pages?: unknown; textStyles: Record<string, string>; doc?: unknown; docs?: unknown }>(model: FigmaModel, data: T): string {
  const shell = Object.fromEntries(SHELL_PARTS.filter((k) => data.shell[k]).map((k) => [k, data.shell[k]]));
  const { pages: _pages, textStyles: _textStyles, ...kept } = data;
  const cfg = { ...kept, shell, ...lookups(model, { ...data, shell }) };
  return `// GENERATED by sketchbook sync docs. Run with the Figma MCP use_figma tool.
const cfg = ${JSON.stringify(cfg)};
${RUNTIME}`;
}

export const HELPERS = `const report = { page: cfg.page, docs: [], rows: [], bound: 0, links: 0, zeros: 0, missing: [], errors: [] };
${ZERO_RUNTIME}const S = cfg.shell;
const page = figma.root.children.find((p) => p.name === cfg.page);
if (!page) throw new Error('No page "' + cfg.page + '": run sketchbook sync pages first.');
await figma.setCurrentPageAsync(page);
const V = figma.variables;
const collections = await V.getLocalVariableCollectionsAsync();
const cols = Object.fromEntries(collections.map((c) => [c.id, c.name]));
const byKey = new Map((await V.getLocalVariablesAsync()).map((v) => [cols[v.variableCollectionId] + '::' + v.name, v]));
const variable = (token) => { const v = cfg.vars[token] && byKey.get(cfg.vars[token]); if (!v) report.missing.push(token); return v; };
const textStyles = await figma.getLocalTextStylesAsync();
const effectStyles = await figma.getLocalEffectStylesAsync();
for (const s of textStyles) await figma.loadFontAsync(s.fontName);
await figma.loadFontAsync({ family: 'Inter', style: 'Regular' });
const PAD = ['paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft'];
const RADII = ['topLeftRadius', 'topRightRadius', 'bottomRightRadius', 'bottomLeftRadius'];
const bind = (node, token, fields) => { const v = variable(token); if (!v) return; for (const f of fields) node.setBoundVariable(f, v); report.bound++; };
const paint = (token) => { const v = variable(token); if (!v) return []; report.bound++; return [V.setBoundVariableForPaint({ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', v)]; };
const box = (name, o = {}) => {
  const b = figma.createAutoLayout(o.dir === 'row' ? 'HORIZONTAL' : 'VERTICAL');
  b.name = name; b.fills = o.fill ? paint(o.fill) : [];
  if (o.wrap) b.layoutWrap = 'WRAP';
  if (o.width) { b.resize(o.width, b.height); b.primaryAxisSizingMode = o.dir === 'row' ? 'FIXED' : 'AUTO'; b.counterAxisSizingMode = o.dir === 'row' ? 'AUTO' : 'FIXED'; }
  if (o.center) b.counterAxisAlignItems = 'CENTER';
  if (o.gap) bind(b, o.gap, o.wrap ? ['itemSpacing', 'counterAxisSpacing'] : ['itemSpacing']);
  if (o.gapPx !== undefined) { b.itemSpacing = o.gapPx; if (o.wrap) b.counterAxisSpacing = o.gapPx; }
  if (o.pad) bind(b, o.pad, PAD);
  if (o.stroke) { b.strokes = paint(o.stroke); b.strokeAlign = 'INSIDE'; b.strokesIncludedInLayout = false; bind(b, o.strokeWidth, ['strokeWeight']); }
  if (o.radius) bind(b, o.radius, RADII);
  return b;
};
const text = async (chars, o) => {
  const t = figma.createText();
  const name = o.style ? cfg.textByToken[o.style] : cfg.styles[o.size];
  const style = textStyles.find((s) => s.name === name);
  if (style) await t.setTextStyleIdAsync(style.id); else report.missing.push('text style for ' + (o.style || o.size));
  t.characters = String(chars);
  t.fills = paint(o.color);
  if (o.name) t.name = o.name;
  if (o.width) { t.resize(o.width, t.height); t.textAutoResize = 'HEIGHT'; } else t.textAutoResize = 'WIDTH_AND_HEIGHT';
  return t;
};
const rect = (name, o) => {
  const r = figma.createRectangle(); r.name = name; r.fills = o.fill ? paint(o.fill) : [];
  if (o.w) bind(r, o.w, ['width']); else if (o.wPx) r.resize(o.wPx, r.height);
  if (o.h) bind(r, o.h, ['height']);
  if (o.stroke) { r.strokes = paint(o.stroke); r.strokeAlign = 'INSIDE'; bind(r, o.strokeWidth, ['strokeWeight']); }
  if (o.radius) bind(r, o.radius, RADII);
  return r;
};
const pin = (node, mode) => {
  if (!mode || !cfg.modeAxis) return;
  const c = collections.find((x) => x.name === cfg.modeAxis.collection);
  const m = c && c.modes.find((x) => x.name === cfg.modeAxis.modes[mode]);
  if (m) node.setExplicitVariableModeForCollection(c, m.modeId); else report.missing.push('mode ' + mode);
};
const fillW = (child) => { child.layoutSizingHorizontal = 'FILL'; return child; };
const spanPx = (span, inner) => { const n = cfg.px.columns, g = cfg.px.gutter, k = (n * span[0]) / span[1]; return ((inner - (n - 1) * g) / n) * k + (k - 1) * g; };
const inner = cfg.px.width - 2 * cfg.px.docPad;
const caption = (chars, width) => text(chars, { name: 'Caption', size: S.caption.size, color: S.caption.color, width });

let markNode;
const brandMark = async () => {
  if (markNode !== undefined) return markNode;
  const L = S.header.logo, g = figma.root.children.find((x) => x.name === L.page);
  if (g) await g.loadAsync();
  markNode = (g && g.children.find((n) => n.type === 'COMPONENT' && n.name === L.component)) || null;
  return markNode;
};
async function header(d) {
  const H = S.header;
  const h = box('Header', { fill: H.fill, radius: H.radius, pad: H.pad, gap: H.gap });
  h.clipsContent = true;
  const brand = box('Brand', { dir: 'row' });
  const mark = await brandMark();
  let logo;
  if (mark) { logo = mark.createInstance(); logo.name = 'Logo'; bind(logo, H.logo.size, ['width', 'height']); }
  else { logo = rect('Logo', { fill: H.logo.fill, w: H.logo.size, h: H.logo.size, radius: H.logo.radius }); report.brand = 'no ' + H.logo.component + ' component on ' + H.logo.page + ': square drawn (sketchbook sync brand)'; }
  brand.appendChild(logo); h.appendChild(brand);
  const width = spanPx(H.titleSpan, inner);
  const title = box('Title', { gap: H.gap, width });
  h.appendChild(title);
  title.appendChild(await text(d.name, { name: 'Name', size: H.name.size, color: H.name.color, width }));
  title.appendChild(await text(H.link.label, { name: 'Link', size: H.link.size, color: H.link.color, width }));
  title.appendChild(await text(d.definition, { name: 'Definition', size: H.definition.size, color: H.definition.color, width }));
  return h;
}
const docFrame = (name) => box(name, { fill: S.doc.fill, radius: S.doc.radius, width: cfg.px.width });
async function cover(doc, d) {
  const top = box('Top', { pad: S.doc.pad });
  doc.appendChild(top); fillW(top);
  const h = await header(d);
  top.appendChild(h); fillW(h);
  return h;
}
function rings(h) {
  const P = S.header.pattern, Hh = h.height, W = h.width;
  for (let i = 0; i < P.count; i++) {
    const r = (P.start + i * P.step) * Hh;
    const e = figma.createEllipse(); e.name = 'Pattern ring ' + (i + 1);
    h.insertChild(0, e); e.layoutPositioning = 'ABSOLUTE';
    e.resize(2 * r, 2 * r); e.x = W - r; e.y = Hh / 2 - r;
    e.fills = []; e.strokes = paint(P.color); bind(e, P.strokeWidth, ['strokeWeight']);
    e.opacity = cfg.px.patternOpacity * (1 - i / P.count);
  }
}
async function item(it, w) {
  const X = S.sample;
  if (it.kind === 'text') {
    const k = box('Sample', { gap: X.gap, width: w });
    const t = await text(it.text, { name: 'Text', style: it.style, color: S.section.title.color, width: w });
    k.appendChild(t); fillW(t);
    const c = await caption(it.caption, w); k.appendChild(c); fillW(c);
    return k;
  }
  if (it.kind === 'bar') {
    const k = box('Sample', { dir: 'row', gap: X.gap, width: w, center: true });
    k.appendChild(rect('Bar', { fill: X.fill, stroke: X.stroke, strokeWidth: X.strokeWidth, w: it.token, h: X.bar }));
    k.appendChild(await caption(it.caption));
    return k;
  }
  const k = box('Sample', { gap: X.gap, width: w });
  let shape;
  if (it.kind === 'swatch') { shape = rect('Swatch', { fill: it.token, stroke: X.stroke, strokeWidth: X.strokeWidth, h: X.size }); k.appendChild(shape); fillW(shape); }
  if (it.kind === 'radius') { shape = rect('Radius', { fill: X.fill, stroke: X.stroke, strokeWidth: X.strokeWidth, w: X.size, h: X.size, radius: it.token }); k.appendChild(shape); }
  if (it.kind === 'square') { shape = rect('Size', { fill: X.fill, stroke: X.stroke, strokeWidth: X.strokeWidth, w: it.token, h: it.token }); k.appendChild(shape); }
  if (it.kind === 'line') { shape = rect('Line', { fill: S.section.title.color, w: X.size, h: it.token }); k.appendChild(shape); }
  if (it.kind === 'opacity') { shape = rect('Opacity', { fill: S.header.logo.fill, w: X.size, h: X.size }); bind(shape, it.token, ['opacity']); k.appendChild(shape); }
  if (it.kind === 'shadow') {
    shape = rect('Shadow', { fill: X.fill, w: X.size, h: X.size, radius: S.cards.specimen.radius });
    const e = effectStyles.find((x) => x.name === cfg.effects[it.token]);
    if (e) await shape.setEffectStyleIdAsync(e.id); else report.missing.push('effect style for ' + it.token);
    k.appendChild(shape);
  }
  if (it.label) { const l = await text(it.label, { name: 'Label', size: S.tag.name.size, color: S.tag.name.color, width: w }); k.appendChild(l); fillW(l); }
  if (it.caption) { const c = await caption(it.caption, w); k.appendChild(c); fillW(c); }
  return k;
}
async function cell(c, w) {
  if (c.text !== undefined) return text(c.text, { name: 'Cell', size: S.cards.instruction.text.size, color: c.accent ? S.code.highlight : S.cards.instruction.text.color, width: w });
  const k = box('Cell', { dir: 'row', gap: S.sample.gap, width: w, center: true });
  pin(k, c.mode);
  if (c.kind === 'swatch') k.appendChild(rect('Swatch', { fill: c.token, stroke: S.sample.stroke, strokeWidth: S.sample.strokeWidth, w: S.sample.size, h: S.sample.bar, radius: S.tag.radius }));
  if (c.kind === 'pair') {
    const p = box('Pair', { dir: 'row', fill: c.bg, pad: S.tag.pad, radius: S.tag.radius, stroke: S.sample.stroke, strokeWidth: S.sample.strokeWidth });
    p.appendChild(await text('Aa', { name: 'Sample', size: S.tag.name.size, color: c.fg }));
    k.appendChild(p);
  }
  k.appendChild(await caption(c.caption));
  return k;
}
let codeFont;
const mono = async () => {
  if (codeFont !== undefined) return codeFont;
  const families = new Set((await figma.listAvailableFontsAsync()).filter((f) => f.fontName.style === 'Regular').map((f) => f.fontName.family));
  const family = (cfg.codeFamilies || []).find((f) => families.has(f));
  codeFont = family ? { family, style: 'Regular' } : null;
  if (codeFont) { await figma.loadFontAsync(codeFont); report.codeFont = family; } else report.missing.push('code font: none of ' + (cfg.codeFamilies || []).join(', '));
  return codeFont;
};
let libHome = null;
const setOf = async (t) => {
  if (!libHome) { const lib = figma.root.children.find((p) => p.name === 'Library'); await lib.loadAsync(); libHome = lib.children.find((n) => n.type === 'FRAME' && n.name === 'Component library') || lib; }
  return libHome.children.find((n) => (n.type === 'COMPONENT_SET' || n.type === 'COMPONENT') && n.name === t);
};
const instanceOf = async (title, variant) => {
  const set = await setOf(title);
  const v = set && (set.type === 'COMPONENT' ? set : set.children.find((c) => c.name === variant) || set.children.find((c) => c.name.startsWith(variant + ', ')));
  if (!v) { report.missing.push(title + ': ' + variant); return null; }
  report.instances = (report.instances || 0) + 1;
  return v.createInstance();
};
async function pill(label, value, token) {
  const T = S.tag;
  const p = box('Tag', { dir: 'row', fill: T.fill, stroke: T.stroke, strokeWidth: T.strokeWidth, radius: T.radius, pad: T.pad, gap: T.gap, center: true });
  bind(p, T.padX, ['paddingLeft', 'paddingRight']);
  if (token) p.appendChild(rect('Dot', { fill: token, stroke: T.stroke, strokeWidth: T.strokeWidth, w: T.dot, h: T.dot, radius: T.radius }));
  p.appendChild(await text(label, { name: 'Name', size: T.name.size, color: T.name.color }));
  if (value) p.appendChild(await text(value, { name: 'Value', size: T.value.size, color: T.value.color }));
  return p;
}
async function treeNode(n, depth, w) {
  const N = S.tree.node;
  const b = box('Part ' + n.name, { fill: depth % 2 ? N.alt : N.fill, stroke: N.stroke, strokeWidth: N.strokeWidth, radius: N.radius[Math.min(depth, N.radius.length - 1)], pad: N.pad, gap: N.gap });
  const head = box('Head', { dir: 'row', wrap: true, gap: S.tag.gap, center: true });
  b.appendChild(head); fillW(head);
  head.appendChild(await text(n.name, { name: 'Name', size: N.name.size, color: N.name.color }));
  for (const t of n.tags) head.appendChild(await pill(t));
  const iw = w - 2 * (depth + 1) * cfg.px.treePad;
  if (n.note) { const t = await text(n.note, { name: 'Note', size: N.note.size, color: N.note.color, width: iw }); b.appendChild(t); fillW(t); }
  for (const k of n.children) { const x = await treeNode(k, depth + 1, w); b.appendChild(x); fillW(x); }
  return b;
}
async function grid(c, w) {
  const M = S.matrix, line = cfg.px.line, per = c.per || c.cols.length;
  const labelW = Math.round(w / 6);
  const g = box('Grid', { fill: M.lineColor, gap: M.line });
  const row = async (label, items, head) => {
    const cellW = Math.floor((w - labelW - items.length * line) / items.length);
    const r = box(head ? 'Head' : 'Row ' + label, { dir: 'row', gap: M.line });
    g.appendChild(r); fillW(r);
    const lead = box('Label', { fill: M.head.fill, pad: M.head.pad, width: labelW });
    lead.appendChild(await text(label, { name: 'Text', size: (head ? M.head.text : M.axis).size, color: (head ? M.head.text : M.axis).color, width: labelW - 2 * cfg.px.matrixPad }));
    r.appendChild(lead); lead.layoutSizingVertical = 'FILL';
    for (const it of items) {
      const x = it === null ? box('Excluded', { fill: M.excluded.fill, pad: M.cell.pad, width: cellW, center: true })
        : head ? box('Column', { fill: M.head.fill, pad: M.head.pad, width: cellW }) : box('Cell', { fill: M.cell.fill, pad: M.cell.pad, gap: M.cell.gap, width: cellW, center: true });
      x.clipsContent = false;
      if (head) x.appendChild(await text(it, { name: 'Text', size: M.head.text.size, color: M.head.text.color, width: cellW - 2 * cfg.px.matrixPad }));
      else if (it === null) x.appendChild(await text(M.excluded.label, { name: 'Text', size: M.excluded.text.size, color: M.excluded.text.color }));
      else {
        const i = await instanceOf(c.set, it);
