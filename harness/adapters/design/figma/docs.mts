const MATRIX_VERIFY = `if (sumOf(JSON.stringify({ page: cfg.page, name: cfg.name, columns: cfg.columns, axes: cfg.axes, rows: cfg.rows })) !== cfg.sum) throw new Error('This script was altered when pasted (checksum mismatch); paste the file exactly.');
