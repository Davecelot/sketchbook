    const col = cfg.columns[i];
    const got = modesOf(cell);
    for (const a of cfg.axes) if ((got[a.collection] || null) !== (col.modes[a.group] || null)) problems.push(title + ' / ' + col.name + ': ' + a.collection + ' is ' + (got[a.collection] || 'unpinned'));
    const k = cell.children.filter((x) => x.type === 'INSTANCE').length;
    if (k !== n) problems.push(title + ' / ' + col.name + ': ' + k + ' instances, expected ' + n);
  });
}
return { ok: !problems.length, rows: cfg.rows.length, columns: cfg.columns.length, problems: problems.slice(0, 20), more: Math.max(0, problems.length - 20) };
`;
