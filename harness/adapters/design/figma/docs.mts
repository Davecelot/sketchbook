};
const cellBox = (name) => { const b = box(name, { fill: T.cellFill, pad: T.cellPad, gap: T.cellGap, radius: T.cellRadius, stroke: T.cellStroke, strokeWidth: T.cellStrokeWidth, width: cfg.px.cellWidth }); b.clipsContent = false; return b; };
