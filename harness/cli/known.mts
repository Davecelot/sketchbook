// harness/cli/known-commands.json, generated from the command registry plus harness/cli/planned-commands.json
// (SB-0053). harness/test/claude-layer.test.mts rejects any `sketchbook <cmd>` in .claude/ that is not listed;
// check G1 keeps the file fresh (npm run build:cli-docs writes it).
import { writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { commands, subcommandsOf } from './registry.mjs';
import { readJson, isMain } from '../lib/files.mjs';

export interface PlannedCommands {
  starters?: string[];
  commands?: Record<string, { summary: string; subcommands?: string[] }>;
}

interface KnownEntry { summary: string; planned?: true; subcommands?: string[] }

const PLANNED = fileURLToPath(new URL('./planned-commands.json', import.meta.url));
export const KNOWN_FILE = 'harness/cli/known-commands.json';

const union = (...lists: string[][]): string[] => [...new Set(lists.flat().filter(Boolean))];

export function knownCommands(planned: PlannedCommands = readJson<PlannedCommands>(PLANNED)): string {
  const out: { $description: string; starters: string[]; commands: Record<string, KnownEntry> } = {
    $description: 'GENERATED by harness/cli/known.mts from the command registry (harness/cli/commands/*.mts) and harness/cli/planned-commands.json. Do not edit: add a command module, or a planned entry. Every `sketchbook` command and `--start` starter the Claude layer (.claude/) may name; harness/test/claude-layer.test.mts rejects any other (SB-0038). `planned: true` means not in the registry yet, so docs say `sketchbook help <cmd>` to confirm options.',
    starters: union(...commands().map((c) => c.starters ?? []), planned.starters ?? []),
    commands: {},
  };
  for (const c of commands()) {
    const subs = union(subcommandsOf(c).map((s) => s.name), planned.commands?.[c.name]?.subcommands ?? []);
    out.commands[c.name] = { summary: c.summary, ...(subs.length ? { subcommands: subs } : {}) };
  }
  for (const [name, p] of Object.entries(planned.commands ?? {})) {
    if (out.commands[name]) continue;
    out.commands[name] = { summary: p.summary, planned: true, ...(p.subcommands?.length ? { subcommands: p.subcommands } : {}) };
  }
  return JSON.stringify(out, null, 2) + '\n';
}

if (isMain(import.meta.url)) {
  writeFileSync(fileURLToPath(new URL('./known-commands.json', import.meta.url)), knownCommands());
  console.log(`${KNOWN_FILE} written from the command registry and planned-commands.json`);
}
