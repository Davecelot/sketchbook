{
  "$schema": "./spec/schemas/brand-config.schema.json",
  "name": "default",
  "$description": "Default = shadcn/ui 'neutral' theme on Tailwind v4 scales. Set color.primary to a hex to brand it; change font, radius style or density to restyle everything.",
  "color": {
    "primary": "neutral",
    "neutral": { "hue": 0, "chroma": 0 },
    "accents": { "danger": "#E7000B" },
    "ramp": { "method": "oklch", "steps": [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950] }
  },
  "modes": ["light", "dark"],
  "typography": { "family": "ui-sans-serif", "fallback": "system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'", "baseSize": 16, "scale": "tailwind", "letterSpacing": { "preset": "tailwind" } },
  "spacing": { "base": 4, "steps": [0, 0.5, 1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10, 12, 16] },
  "radius": { "style": "soft" },
  "density": "comfortable",
  "breakpoints": { "preset": "tailwind" },
  "contrast": { "standard": "WCAG21-AA", "apca": true }
}
