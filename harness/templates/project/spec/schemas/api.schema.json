{
  "$id": "api.schema.json",
  "title": "API vocabulary",
  "type": "object",
  "required": ["version", "vocabularies", "props", "content", "states", "events", "aliases", "extensions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$description": { "type": "string" },
    "version": { "type": "integer" },
    "vocabularies": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "meaning", "figma"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["variant", "boolean", "text", "number"] },
          "values": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
          "meaning": { "type": "string", "minLength": 1 },
          "figma": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/figma" }] },
          "proposal": { "type": "boolean" }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "meaning", "figma"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["text", "icon", "slot"] },
          "meaning": { "type": "string", "minLength": 1 },
          "figma": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/figma" }] }
        }
      }
    },
    "states": {
      "type": "object",
      "required": ["axis", "keys"],
      "additionalProperties": false,
      "properties": {
        "axis": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "keys": { "type": "object", "additionalProperties": { "type": "string" } },
        "canonicalKeys": { "type": "object", "additionalProperties": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] } },
        "draw": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["axis"],
            "additionalProperties": false,
            "properties": {
              "axis": { "type": "string" },
              "values": { "type": "array", "minItems": 2, "items": { "type": "string" } },
              "atRestOnly": { "type": "boolean" },
              "excludes": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "meaning": { "type": "string" }
      }
    },
    "events": {
      "type": "object",
      "required": ["standard", "customPrefix"],
      "additionalProperties": false,
      "properties": {
        "standard": { "type": "array", "items": { "type": "string" } },
        "customPrefix": { "type": "string" },
        "aliases": { "type": "object", "additionalProperties": { "type": "string" } },
        "meaning": { "type": "string" }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["to"],
        "additionalProperties": false,
        "properties": {
          "to": { "type": "string" },
          "in": { "enum": ["props", "content"] },
          "values": { "type": "object", "additionalProperties": { "type": "string" } },
          "proposal": { "type": "boolean" }
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["meaning", "text"],
        "additionalProperties": false,
        "properties": {
          "meaning": { "type": "string", "minLength": 1 },
          "text": { "type": "object", "required": ["name", "visible"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "visible": { "type": "string" }, "underline": { "type": "string" } } },
          "icon": { "type": "object", "required": ["visible", "swap"], "additionalProperties": false, "properties": { "visible": { "type": "string" }, "swap": { "type": "string" } } }
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": { "type": "object", "required": ["reason"], "additionalProperties": false, "properties": { "reason": { "type": "string", "minLength": 1 } } }
    },
    "sets": {
      "type": "object",
      "description": "Elements drawn as design-file sets of their own: <component>.<element tag without the prefix>.",
      "additionalProperties": { "type": "object", "required": ["meaning"], "additionalProperties": false, "properties": { "meaning": { "type": "string", "minLength": 1 } } }
    },
    "regions": {
      "type": "object",
      "description": "Content regions drawn as design-file slots: <component>.<layer the recipe draws>. The layer takes the slot's name; preferred lists component folders offered first, never a limit.",
      "additionalProperties": { "type": "object", "required": ["name", "meaning"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 }, "meaning": { "type": "string", "minLength": 1 }, "preferred": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } }
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["repeats", "meaning", "figma"],
        "additionalProperties": false,
        "properties": {
          "repeats": { "type": "string" },
          "meaning": { "type": "string", "minLength": 1 },
          "figma": { "type": "object", "required": ["name", "as"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "as": { "enum": ["property"] } } }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["reason"],
        "additionalProperties": false,
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "values": { "type": "array", "items": { "type": "string" } },
          "draw": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "as": { "enum": ["axis", "property", "text", "state"] },
        "state": { "type": "string" },
        "visible": { "type": "string" },
        "swap": { "type": "string" },
        "underline": { "type": "string", "description": "The TEXT property of the underlined twin of this text layer (a variant that underlines it draws a second layer on the underline text style)." }
      }
    }
  }
}
