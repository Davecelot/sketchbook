{
  "$id": "contract.schema.json",
  "title": "Component contract",
  "description": "Typed spec every component is built and checked against (harness contract format). Unconfirmed items carry \"proposal\": true. Additions over the base contract shape: tokens (component layer, D-011) and accessibility.contrast.",
  "type": "object",
  "required": [
    "component",
    "tag",
    "status",
    "platforms",
    "summary",
    "props",
    "anatomy",
    "accessibility",
    "tokens",
    "realizations",
    "openQuestions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "component": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*-[a-z-]+$"
    },
    "status": {
      "enum": [
        "planned",
        "draft",
        "wip",
        "beta",
        "stable",
        "deprecated",
        "code-only"
      ]
    },
    "version": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "web",
          "design"
        ]
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/prop"
      }
    },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "variantMatrix": {
      "type": "object",
      "required": [
        "dimensions"
      ],
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "excludedCombinations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reason"
            ]
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/content"
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/event"
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    },
    "accessibility": {
      "$ref": "#/$defs/accessibility"
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/token"
      }
    },
    "aiHints": {
      "$ref": "#/$defs/aiHints"
    },
    "realizations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": {
          "$ref": "#/$defs/realization"
        },
        "design": {
          "$ref": "#/$defs/realization"
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$extensions": {
      "type": "object",
      "description": "The one open section: keys are dotted namespaces (design.figma), checked by C1; nothing else may be added to a contract."
    },
    "elements": {
      "type": "array",
      "description": "Sub-elements of a component family (shadcn parts as custom elements, e.g. sb-card-header). Each is checked by C3 against its own API.",
      "items": {
        "$ref": "#/$defs/element"
      }
    }
  },
  "$defs": {
    "prop": {
      "type": "object",
      "required": [
        "type",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "text",
            "boolean",
            "variant",
            "instanceSwap",
            "slot",
            "fixed",
            "number"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "default": {
          "type": [
            "string",
            "boolean",
            "number",
            "null"
          ]
        },
        "attribute": {
          "type": "string"
        },
        "reflect": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "proposal": {
          "type": "boolean"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "container",
            "slot",
            "text",
            "icon",
            "control",
            "other"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "part": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "controlledBy": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "component": {
          "type": "string"
        },
        "multiple": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "bubbles",
        "composed",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "bubbles": {
          "type": "boolean"
        },
        "composed": {
          "type": "boolean"
        },
        "cancelable": {
          "type": "boolean"
        },
        "native": {
          "type": "boolean"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string"
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "borderColor": {
          "type": "string",
          "description": "The token the border takes in this state (a focused field: its focus ring color)."
        }
      }
    },
    "token": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\{[^{}]+\\}$"
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^\\{[^{}]+\\}$"
            },
            "type": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      ]
    },
    "accessibility": {
      "type": "object",
      "required": [
        "role",
        "accessibleNameSource",
        "keyboard",
        "contrast"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string"
        },
        "native": {
          "type": "string"
        },
        "accessibleNameSource": {
          "type": "string"
        },
        "formAssociation": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "targetSize": {
          "type": "string"
        },
        "focusRingVisible": {
          "type": "string"
        },
        "missingNameWarning": {
          "type": "string"
        },
        "keyboard": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "aria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "announcements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contrast": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fg",
              "bg",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "fg": {
                "type": "string"
              },
              "bg": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "text",
                  "large-text",
                  "ui"
                ]
              }
            }
          }
        },
        "wcag": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "aiHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "atom",
            "molecule",
            "organism"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "useCases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "use"
            ],
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "string"
              },
              "use": {
                "type": "string"
              }
            }
          }
        },
        "antiPatterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "why",
              "alternative"
            ],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "alternative": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not-started",
            "partial",
            "complete"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object"
        },
        "spec": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "aspect",
              "contract",
              "realization"
            ],
            "additionalProperties": false,
            "properties": {
              "aspect": {
                "type": "string"
              },
              "contract": {
                "type": "string"
              },
              "realization": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "question",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "answered"
          ]
        },
        "answer": {
          "type": "string"
        },
        "answeredOn": {
          "type": "string"
        }
      }
    },
    "element": {
      "type": "object",
      "required": [
        "tag",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*-[a-z-]+$"
        },
        "summary": {
          "type": "string"
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/prop"
          }
        },
        "anatomy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/content"
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/event"
          }
        },
        "role": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
