{
  "family": "motion",
  "$description": "Durations (ms) and easings (cubic-bezier). roles map the semantic motion tokens (duration.fast/normal/slow/loop, easing.standard/enter/exit/linear). Every preset assumes components drop movement under prefers-reduced-motion and keep state feedback.",
  "default": "tailwind-like",
  "presets": [
    {
      "id": "tailwind-like",
      "label": "Utility defaults",
      "values": {
        "durations": {
          "100": 100,
          "150": 150,
          "200": 200,
          "300": 300,
          "500": 500,
          "1000": 1000
        },
        "easings": {
          "standard": [
            0.4,
            0,
            0.2,
            1
          ],
          "in": [
            0.4,
            0,
            1,
            1
          ],
          "out": [
            0,
            0,
            0.2,
            1
          ],
          "linear": [
            0,
            0,
            1,
            1
          ]
        },
        "roles": {
          "duration.fast": "150",
          "duration.normal": "200",
          "duration.slow": "300",
          "duration.loop": "1000",
          "easing.standard": "standard",
          "easing.enter": "out",
          "easing.exit": "in",
          "easing.linear": "linear"
        }
      },
      "description": "Short, quiet transitions with classic ease curves. The default.",
      "source": "https://tailwindcss.com/docs/transition-timing-function",
      "verified": true
    },
    {
      "id": "material-like",
      "label": "Standard and emphasized",
      "values": {
        "durations": {
          "50": 50,
          "100": 100,
          "150": 150,
          "200": 200,
          "250": 250,
          "300": 300,
          "350": 350,
          "400": 400,
          "450": 450,
          "500": 500,
          "550": 550,
          "600": 600,
          "700": 700,
          "800": 800,
          "900": 900,
          "1000": 1000
        },
        "easings": {
          "standard": [
            0.2,
            0,
            0,
            1
          ],
          "standard-decelerate": [
            0,
            0,
            0,
            1
          ],
          "standard-accelerate": [
            0.3,
            0,
            1,
            1
          ],
          "emphasized-decelerate": [
            0.05,
            0.7,
            0.1,
            1
          ],
          "emphasized-accelerate": [
            0.3,
            0,
            0.8,
            0.15
          ],
          "linear": [
            0,
            0,
            1,
            1
          ]
        },
        "roles": {
          "duration.fast": "150",
          "duration.normal": "300",
          "duration.slow": "500",
          "duration.loop": "1000",
          "easing.standard": "standard",
          "easing.enter": "emphasized-decelerate",
          "easing.exit": "emphasized-accelerate",
          "easing.linear": "linear"
        }
      },
      "description": "A fine 50 ms duration ladder; entering elements slow down sharply, leaving ones speed up. Expressive but still brief.",
      "source": "https://raw.githubusercontent.com/material-components/material-components-android/master/docs/theming/Motion.md",
      "verified": true
    },
    {
      "id": "carbon-productive",
