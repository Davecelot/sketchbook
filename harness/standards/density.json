{
  "family": "density",
  "$description": "Control sizing. height = control heights in px (sm, default, lg); padding-x and gap = spacing step keys (space.N). Linked into the semantic layer by spec/tokens/brand-links.json.",
  "default": "comfortable",
  "presets": [
    {
      "id": "compact",
      "label": "Compact",
      "values": {
        "height": {
          "sm": 28,
          "default": 32,
          "lg": 36
        },
        "padding-x": {
          "xs": "1-5",
          "sm": "2-5",
          "default": "3",
          "lg": "5",
          "field": "2-5"
        },
        "gap": {
          "xs": "1",
          "sm": "1",
          "default": "1-5"
        }
      },
      "description": "Smaller controls for data-heavy screens. Keep pointer targets at least 24 px.",
