      "values": {
        "hue": 286,
        "chroma": 0.01
      },
      "description": "Almost neutral with a faint cool cast.",
      "source": "https://tailwindcss.com/docs/colors",
      "verified": false
    },
    {
      "id": "stone",
      "label": "Stone (warm)",
      "values": {
        "hue": 58,
        "chroma": 0.01
