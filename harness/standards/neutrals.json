{
  "family": "neutrals",
  "$description": "Neutral (gray) ramps as an OKLCH hue and chroma. Tinted grays are approximations of common families, not exact copies.",
  "default": "neutral",
  "presets": [
    {
      "id": "neutral",
      "label": "Pure gray",
      "values": {
        "hue": 0,
        "chroma": 0
