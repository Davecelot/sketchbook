  "aiHints": {
    "category": "organism",
    "keywords": [
      "dialog",
      "modal",
      "popup",
      "overlay",
      "search palette",
      "confirm"
    ],
    "useCases": [
      {
        "when": "A short task that needs full attention before returning to the page (edit a profile, a short form)",
        "use": "sb-dialog with a trigger, header, the form and a footer with Cancel (sb-dialog-close) and Save"
      },
      {
        "when": "A search or command palette opened from a button or a shortcut",
        "use": "sb-dialog opened from code, sb-dialog-content with aria-label and hide-close-button, a Command with autofocus inside"
      },
      {
        "when": "Long content that scrolls",
        "use": "sb-dialog; the surface scrolls within the viewport"
      },
      {
        "when": "Optional detail that can stay on the page",
        "use": "Collapsible or Accordion instead of a dialog"
      }
    ],
    "antiPatterns": [
      {
        "pattern": "A dialog with no title and no aria-label",
        "why": "The dialog needs an accessible name (APG)",
        "alternative": "Add sb-dialog-title, or aria-label on sb-dialog-content"
      },
      {
        "pattern": "Removing every visible way to close",
        "why": "A visible close control is strongly recommended (APG)",
        "alternative": "Keep the close button, or add a Cancel button in sb-dialog-close"
      },
      {
        "pattern": "Lists or several paragraphs in sb-dialog-description",
        "why": "The description is read as one string; structure is lost (APG)",
        "alternative": "Keep the description to one short line and put structured content in the body"
      }
    ]
  },
