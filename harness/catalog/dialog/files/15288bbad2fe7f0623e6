{
  "$schema": "../../schemas/contract.schema.json",
  "component": "Dialog",
  "tag": "sb-dialog",
  "status": "stable",
  "version": "0.1.0",
  "platforms": [
    "web",
    "design"
  ],
  "summary": "A modal window over the page: the rest of the page is inert until it closes. Used for a focused task (search, a short form, a confirmation). Eight custom elements share the open state through context.",
  "dependsOn": [
    "Button"
  ],
  "props": {
    "open": {
      "type": "boolean",
      "default": false,
      "reflect": true,
      "note": "Whether the dialog is showing. The trigger, the close controls, Escape and a backdrop click change it; code can set it too. Set on first render, the dialog opens as soon as it is connected."
    }
  },
  "anatomy": [
    {
      "name": "root",
      "role": "container",
      "parent": null,
      "notes": "sb-dialog: light-DOM wrapper that owns the open state and shares it with its parts through context. No visible box of its own."
    }
  ],
  "content": {
    "default": {
      "required": true,
      "multiple": true,
      "component": "sb-dialog-trigger, sb-dialog-content",
      "notes": "Optionally one trigger, then one content. Without a trigger the dialog is opened from code (open = true), for example from a keyboard shortcut."
    }
  },
  "events": {
    "sb-toggle": {
      "bubbles": true,
      "composed": true,
      "cancelable": false,
      "native": false,
      "detail": null,
      "note": "PROPOSAL: fires on the sb-dialog host after open changes, from a person or from code (like the native dialog's toggle and Collapsible). Read host.open for the new state. Bubbles and is composed, so a listener on an outer dialog also receives a nested dialog's sb-toggle: check event.target."
    },
    "sb-cancel": {
      "bubbles": true,
      "composed": true,
      "cancelable": true,
      "native": false,
      "detail": null,
      "note": "PROPOSAL: fires on the sb-dialog host before Escape or a backdrop click closes the dialog (like the native dialog's cancel). preventDefault() keeps it open, for example to confirm discarding unsaved input. Not fired for the close button, sb-dialog-close or code. Bubbles and is composed, so a listener on an outer dialog also receives a nested dialog's sb-cancel: check event.target before calling preventDefault()."
    }
  },
  "states": {
    "open": {
      "trigger": "open attribute",
      "tokens": [
        "dialog.bg",
        "dialog.shadow",
        "dialog.backdrop"
      ],
      "note": "The surface shows over a dimmed backdrop; the rest of the page is inert and does not scroll."
    }
  },
  "accessibility": {
    "role": "dialog (modal)",
    "native": "dialog",
    "accessibleNameSource": "PROPOSAL: the sb-dialog-title text, through an element reference (ID references do not cross shadow roots, SB-0009); with no title, host aria-label on sb-dialog-content is forwarded. The description, when present, is the accessible description.",
    "missingNameWarning": "Dev-only console warning, once per element, when the content opens with no sb-dialog-title and no aria-label.",
    "targetSize": "The built-in close button is a Button at size icon-small (32x32px, WCAG 2.5.8). Controls placed in the dialog follow their own components.",
    "focusRingVisible": "The dialog surface takes no focus ring; controls inside show their own.",
    "keyboard": {
      "Escape": "close the dialog (fires sb-cancel first; a prevented sb-cancel keeps it open); ignored while an input method is composing text",
      "Tab": "move to the next focusable element inside the dialog; from the last it wraps to the first (Shift+Tab from the first wraps to the last); the page behind is inert",
      "Shift+Tab": "move to the previous focusable element inside the dialog",
      "Enter": "on the trigger's control, open the dialog",
      "Space": "on the trigger's control, open the dialog"
    },
    "aria": [
      "PROPOSAL: role=dialog and the modal state come from the native dialog shown modally, so the page behind is inert and out of the accessibility tree while it is open",
      "on open, focus moves to the first element with autofocus inside the content, otherwise to the first focusable element, otherwise to the close button (APG); for long or read-first content an author puts autofocus on a static start element with tabindex=-1 (APG)",
      "on close, focus returns to the element that was focused before opening (normally the trigger's control); if that element is gone, focus falls back to the document",
      "name: the dialog is labelled by sb-dialog-title through an element reference; with no title, aria-label on sb-dialog-content is forwarded; where element references are unsupported, the title text is copied into aria-label",
      "description: the dialog is described by sb-dialog-description through an element reference; omitted where unsupported (a description is optional, APG)",
      "references are re-resolved when a title or description is added or removed later",
      "sb-dialog-title is a heading at level 2 (the dialog is its own context)",
      "the built-in close button is a Button named by closeLabel (default \"Close\"; translate it); its icon is aria-hidden",
      "the backdrop is presentational; a press and release both on it close the dialog, a drag that starts inside the surface does not",
      "the trigger and close wrappers add no role: the slotted control keeps its own role and name",
      "while open, the page behind does not scroll; nested dialogs keep it locked until the last one closes",
      "forced colors: the surface keeps a visible border"
    ],
    "announcements": [
      "Opening announces the dialog role, its name and its description (from the screen reader, no live region)."
    ],
    "contrast": [
      {
        "fg": "dialog.fg",
        "bg": "dialog.bg",
        "kind": "text"
      },
      {
        "fg": "dialog.description.fg",
        "bg": "dialog.bg",
        "kind": "text"
      }
    ],
    "wcag": [
      "1.3.1",
      "1.4.3",
      "1.4.10",
      "2.1.1",
      "2.1.2",
      "2.4.3",
      "2.4.7",
      "2.5.8",
      "4.1.2"
    ]
  },
