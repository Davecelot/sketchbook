  "openQuestions": [
    {
      "id": "Q1",
      "question": "How do the image and the fallback coordinate across shadow roots?",
      "recommendation": "The avatar provides a context (@lit/context) holding the image status; the image reports load and error, the fallback hides itself when loaded.",
      "status": "answered",
      "answer": "Context from sb-avatar; status reflected in data-image-status.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q2",
      "question": "Name for initials and for the badge?",
      "recommendation": "A label prop on the fallback and on the badge sets role=img and aria-label; without a label the badge is decorative.",
      "status": "answered",
      "answer": "label props as described.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q3",
      "question": "Badge size tokens (8, 10 and 12px do not exist in the size scale)?",
      "recommendation": "Derive from the avatar diameter (30%) in CSS.",
