      "tag": "sb-avatar-fallback",
      "summary": "Shown while there is no loaded image: initials, an icon or any short content, on a muted disc.",
      "props": {
        "label": {
          "type": "text",
          "default": null,
          "note": "Accessible name for initials or an icon. When set the fallback is exposed as an image with this name."
