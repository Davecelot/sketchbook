{
  "$schema": "../../schemas/contract.schema.json",
  "component": "Command",
  "tag": "sb-command",
  "status": "stable",
  "version": "0.1.0",
  "platforms": [
    "web",
    "design"
  ],
  "summary": "A search field that filters a list of grouped actions or destinations; Arrow Up and Down move the active item and Enter selects it. Used inline or inside a dialog as a command palette. Eight custom elements share state through context.",
  "dependsOn": [],
  "props": {
    "label": {
      "type": "text",
      "default": "",
      "required": true,
      "note": "Accessible name of the search field and of the list (\"Search documentation\"). The placeholder is not a name."
    },
    "filter": {
      "type": "variant",
      "values": [
        "auto",
        "manual"
      ],
      "default": "auto",
      "reflect": true,
      "note": "auto hides the items that do not match the search text (rule in Usage, Behavior). manual never hides items: the consumer listens to input and renders the matching items itself (remote or custom search).",
      "proposal": true
    },
    "loop": {
      "type": "boolean",
      "default": false,
      "reflect": true,
      "note": "Arrow Down on the last item moves to the first, and Arrow Up on the first moves to the last.",
      "proposal": true
    },
    "resultsLabel": {
      "type": "text",
      "default": "{count} results",
      "attribute": "results-label",
      "note": "Template for the polite announcement of how many items match after the search text changes; {count} is replaced by the number. Set it to translate the announcement.",
      "proposal": true
    }
  },
  "anatomy": [
    {
      "name": "root",
      "role": "container",
      "parent": null,
      "part": "root",
      "notes": "sb-command: surface that stacks the search field and the list, owns the search text, the active item and the filtering, and shares them through context."
    },
    {
      "name": "status",
      "role": "text",
      "parent": "root",
      "notes": "Visually hidden polite live region for the result count."
    }
  ],
  "content": {
    "default": {
      "required": true,
      "multiple": true,
      "component": "sb-command-input, sb-command-list",
      "notes": "One sb-command-input followed by one sb-command-list."
    }
  },
  "events": {},
  "states": {
    "selected": {
      "trigger": "the item is the active item (moved to by Arrow keys, by pointer hover, or the first match after the search text changes)",
      "tokens": [
        "command.item.active.bg",
        "command.item.active.fg",
        "command.item.active.ring-color",
        "command.item.active.shortcut-fg",
        "command.item.active.ring-width"
      ],
      "note": "Active, not chosen: Enter or a click chooses it. The ring is a PROPOSAL so the active item does not rely on a fill below 3:1."
    },
    "disabled": {
      "trigger": "disabled on an item",
      "tokens": [
        "command.item.disabled-opacity"
      ],
      "note": "Skipped by the arrows and by hover, not selectable, still matched and announced as unavailable."
    }
  },
  "accessibility": {
    "role": "combobox (the search field) controlling a listbox of options, with group for each titled group",
    "native": "input type=text",
    "accessibleNameSource": "label on sb-command names the search field and the listbox. A group is named by its label. An option is named by its text; the shortcut hint is not part of the name.",
    "formAssociation": {
      "value": false,
      "note": "The search field filters the list; its text is not a value to submit, so Command is not a form control (rule form-associated-controls covers controls that stand in for a native form field). PROPOSAL; owner to confirm (Q3)."
    },
    "targetSize": "Each item is at least 32px high (20px line plus 6px padding on each side) and spans the list width (WCAG 2.5.8).",
    "focusRingVisible": "DOM focus stays in the search field, which shows its caret; the active item shows the accent fill plus a 2px inset ring in command.item.active.ring-color. No ring around the search field (Q4), except with no active item (a search with no match): then the search row shows the same ring (command.item.active.ring-color, command.item.active.ring-width; owner decision, 2026-11-12).",
    "missingNameWarning": "Console warning, once per sb-command, when label is empty.",
    "keyboard": {
      "ArrowDown": "next enabled visible item becomes active; stops at the last unless loop",
      "ArrowUp": "previous enabled visible item becomes active; stops at the first unless loop",
      "Enter": "selects the active item (fires sb-select); never submits a surrounding form",
      "Home": "moves the caret to the start of the search text (APG editable combobox), not to the first item",
      "End": "moves the caret to the end of the search text",
      "Escape": "not handled, so it reaches the container (a dialog closes)",
      "Tab": "leaves the command; the search field is its only tab stop",
      "Printable characters": "edit the search text; the first matching enabled item becomes active"
    },
    "aria": [
      "search field: native input with role=combobox, aria-expanded=true (the list is always shown), aria-autocomplete=list, aria-label from label; autocomplete, autocorrect and spellcheck off",
      "search field to list: aria-controls through the ariaControlsElements property; an element reference from a shadow root to the light DOM above it resolves, an ID would not (SB-0009)",
      "active item: aria-activedescendant through the ariaActiveDescendantElement property on the search field, pointing at the active sb-command-item host; cleared when no item matches",
      "list: role=listbox as a host attribute with aria-label copied from label",
      "group: role=group as a host attribute with aria-label from its label; the visible heading is aria-hidden so it is not read twice",
      "item: role=option as a host attribute, aria-selected=true only on the active item, aria-disabled=true when disabled",
      "separator and empty state are role=none inside the listbox (a listbox owns only options and groups); the empty text is announced through the status region",
      "shortcut hint: aria-hidden; when the app really registers the shortcut, the consumer sets aria-keyshortcuts on the item",
      "decorative icons in the search field and items are aria-hidden",
      "filtered-out items, empty groups and separators while searching are hidden from the accessibility tree, not only visually",
      "references (aria-controls, aria-activedescendant) are re-resolved when items are added, removed or filtered",
      "forced colors: the active item is Highlight on HighlightText"
    ],
    "announcements": [
      "after the search text changes and typing pauses, a polite status announces resultsLabel with the count of visible enabled items, or the sb-command-empty text when nothing matches",
      "moving the active item is announced by the screen reader through aria-activedescendant (option name, position in set); the arrows skip disabled items, so a disabled option is never active and is not announced as unavailable that way; it is found in browse mode"
    ],
    "contrast": [
