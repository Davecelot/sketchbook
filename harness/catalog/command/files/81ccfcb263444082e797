  "aiHints": {
    "category": "organism",
    "keywords": [
      "command",
      "command palette",
      "command menu",
      "search",
      "quick search",
      "spotlight",
      "cmdk",
      "combobox",
      "filter list",
      "jump to"
    ],
    "useCases": [
      {
        "when": "Site or app search over a known set of pages or actions, opened with a shortcut",
        "use": "sb-command inside sb-dialog (the command palette composition), with groups per section"
      },
      {
        "when": "A filterable list of actions shown in the page",
        "use": "sb-command inline, sized by its container"
      },
      {
        "when": "Results come from a server or need a custom ranking",
        "use": "filter=manual and render the matching items on input"
      },
      {
        "when": "An action that also has a global keyboard shortcut",
        "use": "sb-command-shortcut in the item, plus aria-keyshortcuts on the item when the app registers it"
      }
    ],
    "antiPatterns": [
      {
        "pattern": "Buttons, links or other controls inside an item",
        "why": "An option in a listbox cannot hold interactive content (WAI-ARIA APG Listbox); focus stays in the search field, so the inner control is unreachable by keyboard",
        "alternative": "One action per item, chosen with sb-select"
      }
    ]
  },
