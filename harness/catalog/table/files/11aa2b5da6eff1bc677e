      "drift": [
        {
          "aspect": "horizontal scroll",
          "contract": "the table does not scroll; wrap wide tables in a scroll area",
          "realization": "the visual reference wraps the table in an overflow container; a display: table host cannot be one"
        },
        {
          "aspect": "hover and footer fill",
          "contract": "muted at 50%, derived in CSS from the token",
          "realization": "same as the reference; light muted is neutral-50 (SB-0004) so the fill is faint"
        },
        {
          "aspect": "colspan",
          "contract": "not available",
          "realization": "custom elements have no colspan or rowspan; use empty cells"
        },
        {
          "aspect": "selected row indicator",
          "contract": "table.row.selected.border = color.input",
          "realization": "the visual reference marks a selected row with a muted fill only (about 1.04:1); the row also gets a 3:1 input-colored outline at table.border-width (WCAG 1.4.11, 1.4.1)"
        }
      ]
    },
