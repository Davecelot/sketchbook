      "drift": [
        {
          "aspect": "table.row.hover.bg",
          "contract": "Hover fill of a body row.",
          "realization": "Rows take hover only in code; the set draws a rest row and a selected row."
        },
        {
          "aspect": "table.row.selected.border",
          "contract": "A selected row carries a 1px input-colored outline (WCAG 1.4.11).",
          "realization": "The library Table sample has no selected row (rows are toggled by boolean properties, not a selection state), so the outline has nothing to draw on."
