  "openQuestions": [
    {
      "id": "Q1",
      "question": "How are table semantics kept with custom elements?",
      "status": "answered",
      "answeredOn": "2026-11-08",
      "answer": "ARIA roles on the hosts and CSS table display, 's table; the flat accessibility tree makes the roles resolve across shadow roots."
    },
    {
      "id": "Q2",
      "question": "How is the table named without ID references?",
      "status": "answered",
      "answeredOn": "2026-11-08",
      "answer": "role=caption on sb-table-caption plus ariaLabelledByElements on sb-table (both in the light DOM tree scope); aria-label copy as fallback."
    },
    {
      "id": "Q3",
      "question": "Does the table scroll horizontally?",
      "status": "answered",
      "answeredOn": "2026-11-08",
      "answer": "No: a host with display: table cannot be a scroll container. Wrap wide tables in sb-scroll-area."
    }
  ],
