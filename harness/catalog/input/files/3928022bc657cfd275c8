{
  "$schema": "../../schemas/contract.schema.json",
  "component": "Input",
  "tag": "sb-input",
  "status": "stable",
  "version": "0.1.0",
  "platforms": [
    "web",
    "design"
  ],
  "summary": "A single-line text field with its label, description and error built in, taking part in forms.",
  "dependsOn": [],
  "props": {
    "label": {
      "type": "text",
      "required": true,
      "default": null,
      "note": "Visible label and accessible name. Required: shadow DOM keeps an external <label for> from reaching the inner input."
    },
    "hideLabel": {
      "type": "boolean",
      "attribute": "hide-label",
      "default": false,
      "note": "Visually hides the label; it stays the accessible name."
    },
    "description": {
      "type": "text",
      "default": "",
      "note": "Help text under the field."
    },
    "errorMessage": {
      "type": "text",
      "attribute": "error-message",
      "default": "",
      "note": "Error message. Setting it marks the field invalid."
    },
    "type": {
      "type": "variant",
      "values": [
        "text",
        "email",
        "password",
        "search",
        "tel",
        "url",
        "number"
      ],
      "default": "text",
      "note": "Native input type."
    },
    "name": {
      "type": "text",
      "default": "",
      "note": "Form field name."
    },
    "value": {
      "type": "text",
      "default": "",
      "note": "Current value; submitted with the form."
    },
    "placeholder": {
      "type": "text",
      "default": "",
      "note": "Example of the expected input. Never a substitute for the label."
    },
    "autocomplete": {
      "type": "text",
      "default": "",
      "note": "Native autocomplete token (WCAG 1.3.5 for personal data)."
    },
    "required": {
      "type": "boolean",
      "default": false,
      "reflect": true,
      "note": "Native required, plus an aria-hidden asterisk after the label . Explain * once per form."
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "reflect": true,
      "note": "Native disabled; dimmed; not submitted."
    },
    "readOnly": {
      "type": "boolean",
      "attribute": "readonly",
      "default": false,
      "reflect": true,
      "note": "Focusable and submitted; not editable."
    },
    "minlength": {
      "type": "number",
      "default": null,
      "note": "Native validation."
    },
    "maxlength": {
      "type": "number",
      "default": null,
      "note": "Native validation."
    },
    "pattern": {
      "type": "text",
      "default": "",
      "note": "Native validation."
    }
  },
  "anatomy": [
    {
      "name": "field",
      "role": "container",
      "parent": null,
      "part": "field",
      "notes": "Vertical stack with the field gap."
    },
    {
      "name": "label",
      "role": "text",
      "parent": "field",
      "part": "label",
      "controlledBy": "label",
      "notes": "Native <label for> in the same shadow root."
    },
    {
      "name": "required-indicator",
      "role": "text",
      "parent": "label",
      "part": "required-indicator",
      "optional": true,
      "controlledBy": "required",
      "notes": "Asterisk, aria-hidden."
    },
    {
      "name": "input",
      "role": "control",
      "parent": "field",
      "part": "input",
      "notes": "Native <input>; receives focus, typing and validation."
    },
    {
      "name": "description",
      "role": "text",
      "parent": "field",
      "part": "description",
      "optional": true,
      "controlledBy": "description"
    },
    {
      "name": "error",
      "role": "text",
      "parent": "field",
      "part": "error",
      "optional": true,
      "controlledBy": "errorMessage",
      "notes": "Persistent polite live region; text appears when invalid."
    }
  ],
  "content": {},
  "events": {
    "input": {
      "bubbles": true,
      "composed": true,
      "native": true,
      "detail": null,
      "note": "Each edit. Native and composed, so it crosses the shadow boundary."
    },
    "change": {
      "bubbles": true,
      "composed": true,
      "native": false,
      "detail": null,
      "note": "Value committed (blur or Enter). Re-dispatched from the host because native change is not composed (NativeControl mixin)."
    }
  },
  "states": {
    "hover": {
      "trigger": "pointer over an enabled field",
      "tokens": []
    },
    "focus-visible": {
      "trigger": "focus in the input",
      "tokens": [
        "input.focus-ring.color",
        "input.focus-ring.width"
      ],
      "borderColor": "input.focus-ring.color",
      "note": "3px solid ring and border in the ring color (see drift for the visual reference)."
    },
    "error": {
      "trigger": "error-message set, or native validity fails after blur or a submit attempt",
      "tokens": [
        "input.border-invalid",
        "input.error.fg"
      ],
      "note": "Never on the first keystroke."
    },
    "disabled": {
      "trigger": "disabled attribute",
      "tokens": [
        "input.disabled-opacity"
      ]
    },
    "read-only": {
      "trigger": "readonly attribute",
      "tokens": []
    }
  },
  "accessibility": {
    "role": "textbox (searchbox for type=search)",
    "native": "input",
    "accessibleNameSource": "The label prop, through a native <label for> in the same shadow root.",
    "formAssociation": {
      "value": true,
      "note": "ElementInternals: setFormValue on input, validity mirrored with setValidity (anchored to the inner input), formResetCallback restores the default value, disabled fields are not submitted."
    },
    "targetSize": "36px high.",
    "focusRingVisible": "On focus of the input; 3px ring in input.focus-ring.color.",
    "missingNameWarning": "Dev-only console warning, once, when label is empty.",
    "keyboard": {
      "Tab": "move focus in and out",
      "typing": "native text editing",
      "Enter": "submits the owning form (handled by the component: the inner input has no form owner)"
    },
    "aria": [
      "aria-describedby -> description and error ids (same root)",
      "aria-invalid=\"true\" when invalid",
      "required: native required on the input; the asterisk is aria-hidden",
      "errorMessage: sets a customError validity, so the form blocks submission",
      "aria-invalid=\"true\" on the host marks the inner input invalid too (as errorMessage does), so a wrapper such as sb-input-group can mark it"
    ],
    "announcements": [
      "error text is announced once when it appears (persistent aria-live=polite region; fix over the reference implementation, where the error is only read on focus)"
    ],
    "contrast": [
      {
        "fg": "input.fg",
        "bg": "input.bg",
        "kind": "text"
      },
      {
        "fg": "input.placeholder",
        "bg": "input.bg",
        "kind": "text"
      },
      {
        "fg": "input.label.fg",
        "bg": "color.background",
        "kind": "text"
      },
      {
        "fg": "input.description.fg",
        "bg": "color.background",
        "kind": "text"
      },
      {
        "fg": "input.error.fg",
        "bg": "color.background",
        "kind": "text"
      },
      {
        "fg": "input.border",
        "bg": "input.bg",
        "kind": "ui"
      },
      {
        "fg": "input.border-invalid",
        "bg": "input.bg",
        "kind": "ui"
      },
      {
        "fg": "input.focus-ring.color",
        "bg": "color.background",
        "kind": "ui"
      }
    ],
    "wcag": [
      "1.3.1",
      "1.3.5",
      "1.4.3",
      "1.4.11",
      "2.4.6",
      "2.4.7",
      "3.3.1",
      "3.3.2",
      "4.1.2",
      "4.1.3"
    ]
  },
  "tokens": {
    "input.font-family": "{font.family.body}",
    "input.font-size": "{font.size.control}",
    "input.line-height": "{font.line-height.control}",
    "input.height": "{size.control.default}",
    "input.padding-x": "{space.control.padding-x.field}",
    "input.padding-y": "{space.control.padding-y.field}",
    "input.radius": "{radius.control}",
    "input.border-width": "{border-width.default}",
    "input.bg": "{color.input-background}",
    "input.fg": "{color.foreground}",
    "input.border": "{color.input}",
    "input.border-invalid": "{color.destructive}",
    "input.placeholder": "{color.muted-foreground}",
    "input.shadow": "{elevation.xs}",
    "input.gap": "{space.field.gap}",
    "input.label.fg": "{color.foreground}",
    "input.label.font-size": "{font.size.control}",
    "input.label.font-weight": "{font.weight.label}",
    "input.label.line-height": "{font.line-height.label}",
    "input.description.fg": "{color.muted-foreground}",
    "input.description.font-size": "{font.size.body}",
    "input.description.line-height": "{font.line-height.body}",
    "input.error.fg": "{color.destructive}",
    "input.focus-ring.color": "{color.ring}",
    "input.focus-ring.width": "{focus.ring.width}",
    "input.disabled-opacity": "{opacity.disabled}",
    "input.transition-duration": "{motion.duration.fast}",
    "input.transition-easing": "{motion.easing.standard}"
  },
  "aiHints": {
    "category": "molecule",
    "keywords": [
      "input",
      "text field",
      "form",
      "email",
      "password",
      "search"
    ],
    "useCases": [
      {
        "when": "Short free text: names, emails, codes, search",
        "use": "sb-input with a label"
      },
      {
        "when": "The label would repeat visible context (e.g. a search bar)",
        "use": "hide-label, keep the label text"
      },
      {
        "when": "Format or purpose needs explaining before typing",
        "use": "description"
      },
      {
        "when": "Server or custom validation failed",
        "use": "errorMessage with what went wrong and how to fix it"
      }
    ],
    "antiPatterns": [
      {
        "pattern": "Placeholder as the only label",
        "why": "It disappears on typing and is not a reliable accessible name",
        "alternative": "label (visible or hide-label)"
      },
      {
        "pattern": "Showing errors on the first keystroke",
        "why": "Punishes people for not being done yet",
        "alternative": "Validate on blur or submit"
      },
      {
        "pattern": "Multi-line text in Input",
        "why": "Input is single-line",
        "alternative": "Textarea"
      },
      {
        "pattern": "Asterisks with no explanation",
        "why": "The meaning of * is not universal",
        "alternative": "One line per form: \"* required\""
      }
    ]
  },
  "realizations": {
    "web": {
      "status": "complete",
      "files": [
        "src/components/input/Input.ts",
        "src/components/input/Input.scss",
        "src/components/input/Input.styles.ts",
        "src/components/input/Input.stories.ts",
        "src/components/input/index.ts"
      ],
      "parts": [
        "field",
        "label",
        "required-indicator",
        "input",
        "description",
        "error"
      ],
      "slots": [],
      "spec": "playwright/tests/input/input.behavior.spec.ts",
      "coverage": [
        "label is the name; label click focuses; 36px",
        "hide-label keeps the name",
        "description and error in the accessible description; aria-invalid",
        "native validity after blur, not on first typing",
        "required: native required, aria-hidden asterisk",
        "input on edit, change on commit, both composed",
        "keyboard focus ring",
        "form value, validity, reset, disabled excluded",
        "axe clean on all stories"
      ],
      "drift": [
        {
          "aspect": "API shape",
          "contract": "label, description and error are props of Input",
          "realization": "shadcn composes Field, FieldLabel, FieldDescription, FieldError around Input; shadow DOM requires them inside"
        },
        {
          "aspect": "border color",
          "contract": "color.input = neutral-500 (3:1)",
          "realization": "shadcn default border-input is neutral-200; changed for WCAG 1.4.11"
        },
        {
          "aspect": "dark background",
          "contract": "color.input-background",
          "realization": "shadcn uses input/30 in dark"
        },
        {
          "aspect": "focus ring",
          "contract": "3px solid ring color",
          "realization": "shadcn uses ring/50, below 3:1 (WCAG 1.4.11)"
        },
        {
          "aspect": "implicit submission",
          "contract": "Enter submits via form.requestSubmit() without a submitter",
          "realization": "native inputs submit with the default button as submitter; a sb-button submit name/value is not included on Enter"
        }
      ]
    },
    "design": {
      "status": "complete",
      "properties": {
        "sets": {
          "Input": 6
        }
      },
      "coverage": [
        "Input: 6 variant(s), State (Rest, Focus) x Validation (None, Error) x Disabled (False, True); read back ok"
      ],
      "drift": []
    }
  },
  "openQuestions": [
    {
      "id": "Q1",
      "question": "Where does the label live?",
      "status": "answered",
      "answer": "Inside Input (contract-first standard; option A): native <label for>, description and error in one shadow root.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q2",
      "question": "How are required fields marked?",
      "status": "answered",
      "answer": "the reference implementation: aria-hidden asterisk plus native required; a one-line '* required' legend per form is documented in Usage.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q3",
      "question": "Sizes?",
      "status": "answered",
      "answer": "None: one height (36px).",
      "answeredOn": "2026-11-08"
    }
  ],
  "decisions": [
    "D-001",
