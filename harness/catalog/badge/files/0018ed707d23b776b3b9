      ]
    }
  },
  "aiHints": {
    "category": "atom",
    "keywords": [
      "badge",
      "tag",
      "chip",
      "pill",
      "status",
      "count",
      "label"
    ],
    "useCases": [
      {
        "when": "A short status or category next to a title",
        "use": "variant=secondary or tertiary"
      },
      {
        "when": "A count or an emphasised marker",
        "use": "variant=primary"
      },
      {
        "when": "A failed or critical status",
        "use": "variant=destructive, with words that say what failed"
      },
      {
        "when": "A badge that leads somewhere",
        "use": "set href"
      }
    ],
    "antiPatterns": [
      {
        "pattern": "Color as the only meaning (a red badge with no text)",
        "why": "People who cannot see the color miss it",
        "alternative": "Put the status in words"
      },
      {
        "pattern": "Badge used as a button",
        "why": "It is a label, not a control",
        "alternative": "Button"
      },
      {
        "pattern": "Long sentences in a badge",
        "why": "It does not wrap",
        "alternative": "Alert or plain text"
      }
    ]
  }
