{
  "$schema": "../../schemas/contract.schema.json",
  "component": "Badge",
  "tag": "sb-badge",
  "status": "stable",
  "version": "0.1.0",
  "platforms": [
    "web",
    "design"
  ],
  "summary": "A small pill that labels or counts something, optionally a link.",
  "dependsOn": [],
  "props": {
    "variant": {
      "type": "variant",
      "values": [
        "primary",
        "secondary",
        "destructive",
        "tertiary",
        "ghost",
        "link"
      ],
      "default": "primary",
      "reflect": true,
      "note": "Look of the pill. primary is filled with the primary color; secondary and destructive are filled; tertiary has a border; ghost and link have no fill."
    },
    "href": {
      "type": "text",
      "default": null,
      "note": "Renders the pill as a native link (a). Gains hover and a focus ring, and a 24px minimum height for the target size rule. javascript:, vbscript: and data: URLs are dropped: the link renders without href and a console warning names it (SB-0115)."
    },
    "label": {
      "type": "slot",
      "note": "Default slot: the text or number, optionally with a small svg icon."
    }
  },
  "anatomy": [
    {
      "name": "badge",
      "role": "container",
      "parent": null,
      "part": "badge",
      "notes": "A span, or a native a when href is set."
    }
  ],
  "content": {
    "default": {
      "required": true,
      "multiple": true,
      "notes": "Short text or a number, optionally with an svg icon (12px). Keep it to a word or two."
    }
  },
  "events": {},
  "states": {
    "hover": {
      "trigger": "pointer over a link badge (href)",
      "tokens": [
        "badge.outline.bg-hover",
        "badge.outline.fg-hover",
        "badge.ghost.bg-hover",
        "badge.ghost.fg-hover"
      ],
      "note": "Filled variants darken with color-mix (90%); link underlines. Plain (non-link) badges do not react."
    },
    "focus-visible": {
      "trigger": "keyboard focus on a link badge",
      "tokens": [
        "badge.focus-ring.color",
        "badge.focus-ring.width"
      ],
      "note": "Solid 3px ring."
    }
  },
  "accessibility": {
    "role": "none for a plain badge (text); link for a badge with href",
    "native": "span, or a when href is set",
    "accessibleNameSource": "Its text content.",
    "targetSize": "A plain badge is not interactive. A link badge is at least 24px high (badge.link-min-height, WCAG 2.5.8); the plain pill is 22px.",
    "focusRingVisible": "link badge, :focus-visible only, 3px solid ring in badge.focus-ring.color.",
    "keyboard": {
      "Tab": "focuses a link badge",
      "Enter": "follows the link"
    },
    "aria": [
      "a plain badge has no role and is not focusable",
      "with href the inner element is a native link and keeps link semantics",
      "meaning must be in the text: color alone (destructive, secondary) is not the only signal",
      "a badge that shows a changing count does not announce changes; use a status region for that"
    ],
    "announcements": [],
    "contrast": [
      {
        "fg": "badge.default.fg",
        "bg": "badge.default.bg",
        "kind": "text"
      },
      {
        "fg": "badge.secondary.fg",
        "bg": "badge.secondary.bg",
        "kind": "text"
      },
      {
        "fg": "badge.destructive.fg",
        "bg": "badge.destructive.bg",
        "kind": "text"
      },
      {
        "fg": "badge.outline.fg",
        "bg": "color.background",
        "kind": "text"
      },
      {
        "fg": "badge.outline.fg-hover",
        "bg": "badge.outline.bg-hover",
        "kind": "text"
      },
      {
        "fg": "badge.ghost.fg",
        "bg": "color.background",
        "kind": "text"
      },
      {
        "fg": "badge.ghost.fg-hover",
        "bg": "badge.ghost.bg-hover",
        "kind": "text"
      },
      {
        "fg": "badge.link.fg",
        "bg": "color.background",
        "kind": "text"
      },
      {
        "fg": "badge.focus-ring.color",
        "bg": "color.background",
        "kind": "ui"
      }
    ],
    "wcag": [
      "1.3.1",
      "1.4.1",
      "1.4.3",
      "1.4.11",
      "2.4.7",
      "2.5.8",
      "4.1.2"
    ]
  },
  "tokens": {
    "badge.font-family": "{font.family.body}",
    "badge.font-size": "{font.size.caption}",
    "badge.font-weight": "{font.weight.label}",
    "badge.line-height": "{font.line-height.caption}",
    "badge.padding-x": "{space.control.padding-x.xs}",
