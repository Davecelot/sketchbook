    "badge.transition-duration": "{motion.duration.fast}",
    "badge.transition-easing": "{motion.easing.standard}"
  },
  "realizations": {
    "web": {
      "status": "complete",
      "files": [
        "src/components/badge/Badge.ts",
        "src/components/badge/Badge.scss",
        "src/components/badge/Badge.styles.ts",
        "src/components/badge/Badge.stories.ts",
        "src/components/badge/index.ts"
      ],
      "parts": [
        "badge"
      ],
      "slots": [
        "default"
      ],
      "spec": "playwright/tests/badge/badge.behavior.spec.ts",
      "coverage": [
        "span by default, native link with href, swaps with href; name from text",
        "primary, secondary, destructive fill from tokens; tertiary border; ghost and link unfilled",
        "pill shape, size, padding, gap, 12px icon; all variants the same size",
        "link badge: hover, keyboard focus ring, 24px minimum height, Enter navigates, host focus delegates",
        "plain badge: no hover change, not focusable",
        "axe clean (default, variants, links, icon, count)"
      ],
      "drift": [
        {
          "aspect": "dark destructive background",
          "contract": "full destructive color",
          "realization": "the visual reference dims it to 60% in dark mode; that would break contrast with white text"
        },
        {
          "aspect": "link badge height",
          "contract": "at least 24px for href badges (WCAG 2.5.8)",
          "realization": "the visual reference is about 22px high"
        },
        {
          "aspect": "focus ring",
          "contract": "solid 3px ring",
          "realization": "the visual reference uses ring at 50% plus a border color (below 3:1)"
        },
        {
          "aspect": "invalid style",
          "contract": "not provided",
          "realization": "the visual reference styles aria-invalid on a badge, which has no meaning here"
        }
      ]
    },
    "design": {
      "status": "complete",
      "properties": {
        "sets": {
          "Badge": 18
        }
      },
      "coverage": [
        "Badge: 18 variant(s), Variant (Primary, Secondary, Destructive, Tertiary, Ghost, Link) x State (Rest, Hover, Focus); read back ok"
      ],
      "drift": [
        {
          "aspect": "badge.link-min-height",
          "contract": "A badge with href keeps a minimum target height.",
          "realization": "The set draws the badge look, not the link element."
        },
        {
          "aspect": "badge.link.underline-offset",
          "contract": "Underline offset of the link variant on hover.",
          "realization": "The underline is drawn (a second label on the underlined text style, shown on hover); its offset is not: Figma cannot bind a text decoration offset to a variable."
        }
      ]
    }
  },
  "openQuestions": [
    {
      "id": "Q1",
      "question": "Include ghost and link variants?",
      "recommendation": "Yes: the visual reference's current Badge has six variants; ghost and link are useful on a link badge.",
      "status": "answered",
      "answer": "Six variants: primary, secondary, destructive, tertiary, ghost, link.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q2",
      "question": "href option?",
      "recommendation": "Yes, same pattern as Button: render a native a, with a 24px minimum height so the link target meets 2.5.8.",
      "status": "answered",
      "answer": "href renders a native link; link badge min height 24px.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q3",
      "question": "Dark-mode destructive background?",
      "recommendation": "Keep the full destructive color: the visual reference dims it to 60%, which breaks contrast with white text.",
      "status": "answered",
      "answer": "Not reproduced; logged as drift.",
      "answeredOn": "2026-11-08"
    }
  ],
  "decisions": [
    "D-001",
    "D-005",
    "D-011",
    "SB-0007",
    "SB-0011",
    "SB-0115"
  ],
