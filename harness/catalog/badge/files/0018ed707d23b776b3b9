    "badge.destructive.fg": "{color.destructive-foreground}",
    "badge.outline.border": "{color.border}",
    "badge.outline.fg": "{color.foreground}",
    "badge.outline.bg-hover": "{color.accent}",
    "badge.outline.fg-hover": "{color.accent-foreground}",
    "badge.ghost.fg": "{color.foreground}",
    "badge.ghost.bg-hover": "{color.accent}",
    "badge.ghost.fg-hover": "{color.accent-foreground}",
    "badge.link.fg": "{color.primary}",
    "badge.link.underline-offset": "{space.text.underline-offset}",
    "badge.link-min-height": "{size.control.xs}",
    "badge.focus-ring.color": "{color.ring}",
