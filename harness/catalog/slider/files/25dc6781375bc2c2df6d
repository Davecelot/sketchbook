{
  "$schema": "../../schemas/contract.schema.json",
  "component": "Slider",
  "tag": "sb-slider",
  "status": "stable",
  "version": "0.1.0",
  "platforms": [
    "web",
    "design"
  ],
  "summary": "A slider for picking a number, or a range with two thumbs, built on native range inputs, with label, description and error built in, taking part in forms.",
  "dependsOn": [],
  "props": {
    "label": {
      "type": "text",
      "required": true,
      "default": null,
      "note": "Visible label and accessible name. With two values each thumb is named \"<label> minimum\" and \"<label> maximum\"."
    },
    "hideLabel": {
      "type": "boolean",
      "attribute": "hide-label",
      "default": false,
      "note": "Visually hides the label; it stays the accessible name."
    },
    "description": {
      "type": "text",
      "default": "",
      "note": "Help text under the field."
    },
    "errorMessage": {
      "type": "text",
      "attribute": "error-message",
      "default": "",
      "note": "Error message. Setting it marks the field invalid."
    },
    "name": {
      "type": "text",
      "default": "",
      "note": "Form field name. A range submits one entry per thumb under this name."
    },
    "value": {
      "type": "text",
      "default": "",
      "note": "Current values as numbers separated by commas: \"40\" for one thumb, \"20,80\" for a range. One thumb per number. Empty means the minimum. Not reflected: the attribute is the default restored by form reset."
    },
    "min": {
      "type": "number",
      "default": 0,
      "note": "Lowest value."
    },
    "max": {
      "type": "number",
      "default": 100,
      "note": "Highest value."
    },
    "step": {
      "type": "number",
      "default": 1,
      "note": "Increment for keys and snapping."
    },
    "orientation": {
      "type": "variant",
      "values": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal",
      "reflect": true,
      "note": "Direction of the track. Vertical grows upward."
    },
    "required": {
      "type": "boolean",
      "default": false,
      "reflect": true,
      "note": "Accepted for form-associated parity; a slider always has a value, so it never blocks submission and shows no asterisk."
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "reflect": true,
      "note": "Native disabled; dimmed; not submitted."
    }
  },
  "variantMatrix": {
    "dimensions": {
      "orientation": [
        "horizontal",
        "vertical"
      ]
    }
  },
  "anatomy": [
    {
      "name": "field",
      "role": "container",
      "parent": null,
      "part": "field",
      "notes": "Vertical stack with the field gap."
    },
    {
      "name": "label",
      "role": "text",
      "parent": "field",
      "part": "label",
      "controlledBy": "label",
      "notes": "Native <label for> pointing at the first thumb."
    },
    {
      "name": "control",
      "role": "container",
      "parent": "field",
      "part": "control",
      "notes": "Positions the track, range and thumbs; also takes pointer presses on the track of a two-thumb range."
    },
    {
      "name": "track",
      "role": "container",
      "parent": "control",
      "part": "track",
      "notes": "Full-length bar behind the thumbs."
    },
    {
      "name": "range",
      "role": "other",
      "parent": "track",
      "part": "range",
      "notes": "Filled part: from the start to the thumb, or between the two thumbs."
    },
    {
      "name": "thumb",
      "role": "control",
      "parent": "control",
      "part": "thumb",
      "notes": "Native <input type=\"range\">, one per value, drawn as a round handle. Receives focus and keys."
    },
    {
      "name": "description",
      "role": "text",
      "parent": "field",
      "part": "description",
      "optional": true,
      "controlledBy": "description"
    },
    {
      "name": "error",
      "role": "text",
      "parent": "field",
      "part": "error",
      "optional": true,
      "controlledBy": "errorMessage",
      "notes": "Persistent polite live region; text appears when invalid."
    }
  ],
  "content": {},
  "events": {
    "input": {
      "bubbles": true,
      "composed": true,
      "native": true,
      "detail": null,
      "note": "While a thumb moves. Native and composed; a press on the track of a range emits an equivalent event from the host."
    },
    "change": {
      "bubbles": true,
      "composed": true,
      "native": false,
      "detail": null,
      "note": "Value committed (key press, release). Re-dispatched from the host because native change is not composed (NativeControl)."
    }
  },
  "states": {
    "hover": {
      "trigger": "pointer over an enabled thumb",
      "tokens": []
    },
    "focus-visible": {
      "trigger": "keyboard focus on a thumb",
      "tokens": [
        "slider.focus-ring.color",
        "slider.focus-ring.width"
      ],
      "note": "3px solid ring around the focused thumb."
    },
    "error": {
      "trigger": "error-message set",
      "tokens": [
        "slider.border-invalid",
        "slider.error.fg"
      ]
    },
    "disabled": {
      "trigger": "disabled attribute",
      "tokens": [
        "slider.disabled-opacity"
      ]
    }
  },
  "accessibility": {
    "role": "slider (one per thumb)",
    "native": "input type=range",
    "accessibleNameSource": "The label prop through a native <label for> on the first thumb; with a range each thumb also gets an aria-label (\"<label> minimum\", \"<label> maximum\").",
    "formAssociation": {
      "value": true,
      "note": "ElementInternals: setFormValue with the value, or one entry per thumb for a range; the inner input anchors validity (errorMessage sets customError); formResetCallback restores the default values; disabled is not submitted."
    },
    "targetSize": "The thumb is 16px inside a 24px press area (WCAG 2.5.8); the track is also pressable and keys work without any pointer.",
    "focusRingVisible": "On keyboard focus of a thumb; 3px ring in slider.focus-ring.color.",
    "missingNameWarning": "Dev-only console warning, once, when label is empty.",
    "keyboard": {
      "Tab": "move between thumbs and out",
      "ArrowRight / ArrowUp": "increase by step",
      "ArrowLeft / ArrowDown": "decrease by step",
      "PageUp / PageDown": "larger increase or decrease (native)",
      "Home / End": "jump to the minimum or maximum",
      "Enter": "submits the form (implicit submission; the control has no form owner in its shadow root, SB-0009)"
    },
    "aria": [
      "each thumb is a native range input: role slider with aria-valuemin, aria-valuemax and aria-valuenow from the native control",
      "aria-orientation=\"vertical\" on each thumb when vertical",
      "aria-describedby -> description and error ids (same root)",
      "aria-invalid=\"true\" when an error is set",
      "a thumb cannot cross the other: the lower one is clamped to the upper one"
    ],
    "announcements": [
      "error text is announced once when it appears (persistent aria-live=polite region); value changes are announced by the native slider"
    ],
    "contrast": [
      {
        "fg": "slider.label.fg",
        "bg": "color.background",
        "kind": "text"
      },
      {
        "fg": "slider.description.fg",
        "bg": "color.background",
        "kind": "text"
      },
      {
        "fg": "slider.error.fg",
        "bg": "color.background",
        "kind": "text"
      },
      {
        "fg": "slider.thumb.border",
        "bg": "color.background",
        "kind": "ui"
      },
      {
        "fg": "slider.track.bg",
        "bg": "color.background",
        "kind": "ui"
      },
      {
        "fg": "slider.range.bg",
        "bg": "color.background",
        "kind": "ui"
      },
      {
        "fg": "slider.border-invalid",
        "bg": "color.background",
        "kind": "ui"
      },
      {
        "fg": "slider.focus-ring.color",
        "bg": "color.background",
        "kind": "ui"
      }
    ],
    "wcag": [
      "1.3.1",
      "1.4.3",
      "1.4.11",
      "2.1.1",
      "2.4.7",
      "2.5.7",
      "3.3.1",
      "4.1.2",
      "4.1.3"
    ]
  },
  "tokens": {
    "slider.font-family": "{font.family.body}",
    "slider.thumb.size": "{size.icon.default}",
    "slider.target-size": "{size.control.xs}",
    "slider.thumb.bg": "{color.background}",
    "slider.thumb.border": "{color.primary}",
    "slider.thumb.border-width": "{border-width.default}",
    "slider.thumb.shadow": "{elevation.sm}",
    "slider.track.size": "{size.slider.track}",
    "slider.track.bg": "{color.input}",
    "slider.track.radius": "{radius.pill}",
    "slider.range.bg": "{color.primary}",
    "slider.vertical-length": "{size.slider.vertical-length}",
    "slider.border-invalid": "{color.destructive}",
    "slider.gap": "{space.field.gap}",
    "slider.label.fg": "{color.foreground}",
    "slider.label.font-size": "{font.size.control}",
    "slider.label.font-weight": "{font.weight.label}",
    "slider.label.line-height": "{font.line-height.label}",
    "slider.description.fg": "{color.muted-foreground}",
    "slider.description.font-size": "{font.size.body}",
    "slider.description.line-height": "{font.line-height.body}",
    "slider.error.fg": "{color.destructive}",
    "slider.focus-ring.color": "{color.ring}",
    "slider.focus-ring.width": "{focus.ring.width}",
    "slider.disabled-opacity": "{opacity.disabled}",
    "slider.transition-duration": "{motion.duration.fast}",
    "slider.transition-easing": "{motion.easing.standard}"
  },
  "aiHints": {
    "category": "molecule",
    "keywords": [
      "slider",
      "range",
      "volume",
      "price range",
      "numeric",
      "form"
    ],
    "useCases": [
      {
        "when": "Pick a number where approximate position matters more than the exact digit",
        "use": "sb-slider with a label"
      },
      {
        "when": "Pick a lower and upper bound",
        "use": "value with two numbers"
      },
      {
        "when": "People may need the exact number",
        "use": "pair with a number Input"
      }
    ],
    "antiPatterns": [
      {
        "pattern": "A slider for a precise value (an amount, a quantity)",
        "why": "Dragging is imprecise and hard for many people",
        "alternative": "Input type number"
      },
      {
        "pattern": "Hiding the current value",
        "why": "The thumb position alone is not exact",
        "alternative": "Show the value in the label or beside the slider"
      },
      {
        "pattern": "A slider with only a few discrete choices",
        "why": "Choices should be visible",
        "alternative": "Radio Group"
      }
    ]
  },
  "realizations": {
    "web": {
      "status": "complete",
      "files": [
        "src/components/slider/Slider.ts",
        "src/components/slider/Slider.scss",
        "src/components/slider/Slider.styles.ts",
