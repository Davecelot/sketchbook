      "slots": [],
      "spec": "playwright/tests/slider/slider.behavior.spec.ts",
      "coverage": [
        "one slider per value named by the label; label click focuses; a range has distinct minimum and maximum names",
        "arrow, Home, End and Page keys; min, max and step bounds; thumbs cannot cross",
        "track press moves the thumb (native for one, nearest for a range)",
        "filled range geometry for one and two thumbs; 6px track, 24px press area",
        "vertical: ArrowUp increases, aria-orientation, 192px long",
        "keyboard focus ring visible",
        "hide-label, description and error in the accessible description, aria-invalid",
        "input and change reach the host",
        "form entries per thumb, reset, disabled, disabled fieldset, errorMessage customError, label for",
        "Enter submits the form (implicit submission)",
        "axe clean on all stories"
      ],
      "drift": [
        {
          "aspect": "API shape",
          "contract": "value is a comma-separated list, one thumb per number; label, description and error are props",
          "realization": "the visual reference takes a value array and composes Field parts; attributes need a string form and shadow DOM needs the label inside"
        },
        {
          "aspect": "track contrast",
          "contract": "track = color.input",
          "realization": "the visual reference track (muted) is below 3:1 against the page; the track uses color.input, the same 3:1 form-field color as input borders and the switch track (WCAG 1.4.11), and its pair is declared"
        },
        {
          "aspect": "focus ring",
          "contract": "3px solid ring color",
          "realization": "the visual reference uses ring/50 plus a hover ring, below 3:1 (WCAG 1.4.11); no hover ring"
        },
        {
          "aspect": "vertical length",
          "contract": "3 x size.slider.vertical-length = 192px",
          "realization": "the visual reference uses 176px; the foundation scale has no such step"
        },
        {
          "aspect": "thumb stacking",
          "contract": "two inputs overlaid",
          "realization": "when both thumbs sit at the maximum the upper input is on top and the lower thumb is moved by keyboard or by pressing the track"
        }
      ]
    },
    "design": {
      "status": "complete",
      "properties": {
        "sets": {
          "Slider": 12
        }
      },
      "coverage": [
        "Slider: 12 variant(s), Orientation (Horizontal, Vertical) x State (Rest, Focus) x Validation (None, Error) x Disabled (False, True); read back ok"
      ],
      "drift": [
        {
          "aspect": "slider.target-size",
          "contract": "Invisible pointer target around the thumb (WCAG 2.5.8).",
          "realization": "It has no look to draw."
        }
      ]
    }
  },
  "openQuestions": [
    {
      "id": "Q0",
      "question": "Contract content drafted with the contract-author skill (visual reference, WAI-ARIA APG)?",
      "status": "answered",
      "answer": "Yes: APG slider and multi-thumb slider patterns, realized with native range inputs.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q1",
      "question": "How is a range built?",
      "status": "answered",
      "answer": "Two native range inputs overlaid on one track, each a real slider with its own name; the lower one is clamped to the upper one. A press on the track moves the nearest thumb.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q2",
      "question": "How are thumb names built for a range?",
      "status": "answered",
      "answer": "\"<label> minimum\" and \"<label> maximum\" through aria-label; the visible label points at the first thumb. A later change can add props to localize them.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q3",
      "question": "What is the value format?",
      "status": "answered",
      "answer": "A comma-separated list of numbers in the value attribute, one thumb per number; the property returns an array of numbers.",
      "answeredOn": "2026-11-08"
    },
    {
      "id": "Q4",
      "question": "Vertical length against the foundation scale?",
      "status": "answered",
      "answer": "A vertical slider is three times the semantic unit size.slider.vertical-length (64px), 192px, because the scale has no 176px step. Logged as drift.",
      "answeredOn": "2026-11-08"
    }
  ],
