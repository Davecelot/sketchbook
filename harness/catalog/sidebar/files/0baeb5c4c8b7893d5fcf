        "sidebar.transition-duration",
        "sidebar.transition-easing",
        "sidebar.drawer.shadow"
      ],
      "note": "The panel slides along the inline axis; no motion under reduced-motion preferences."
    }
  },
  "accessibility": {
    "role": "navigation (panel); list and listitem (menu); group (group); button with aria-expanded (trigger); modal dialog (drawer, narrow viewports)",
    "native": "nav, a, button, dialog",
    "accessibleNameSource": "Landmark and drawer: the label prop. Group: its group label. Menu button: its text. Trigger: its label prop (default \"Toggle Sidebar\").",
    "missingNameWarning": "Warns when label is set to an empty string: an unnamed drawer has no dialog name.",
    "targetSize": "Menu buttons are at least 32px high and full width; the trigger is 32px square (WCAG 2.5.8). Menu button and group label text wraps and grows the row instead of clipping (WCAG 1.4.12, 1.4.10).",
    "focusRingVisible": ":focus-visible only; 3px solid ring in sidebar.focus-ring.color.",
    "keyboard": {
      "Tab": "moves through the trigger and the links in document order; inside the open drawer it stays within the drawer",
      "Shift+Tab": "moves backwards; stays within the open drawer",
      "Enter": "follows the focused link; on the trigger, toggles the panel or opens the drawer",
      "Space": "on the trigger, toggles the panel or opens the drawer",
      "Escape": "closes the open drawer and returns focus to the trigger",
      "Control+B / Meta+B": "toggles the sidebar like the trigger (panel on wide viewports unless collapsible=none, drawer on narrow); ignored while typing in a text field or editable region"
    },
    "aria": [
      "panel: a native nav landmark named by label (aria-label inside the panel's own tree, so no ID reference crosses a shadow root, SB-0009)",
      "menu: role=list; menu item: role=listitem, set on the hosts only when the author set no role (the pagination pattern); no menu or menuitem roles, since these are site links",
      "group: role=group named by its group label through an element reference (ariaLabelledByElements, as in Tabs); where unsupported the label text is copied into aria-label; with no label (and no author aria-label or aria-labelledby) the group has no role",
      "menu button: a native link when href is set, otherwise a native button; active sets aria-current=page on the link",
      "trigger: a native button with aria-expanded that follows the visible state (panel shown on wide viewports, drawer open on narrow) and aria-controls through an element reference to the panel (ariaControlsElements), never an ID",
      "drawer: a native modal dialog named by label; the rest of the page is inert while it is open; Escape and a press and release both on the backdrop close it (as in Dialog); focus moves to the first focusable element inside and returns to the trigger on close, whether Escape, the backdrop or an activated menu link closed it",
      "viewport change: when the panel and the drawer swap while focus is inside the sidebar, focus moves to the trigger (or to the first menu button when the trigger is hidden)",
      "a collapsed panel (wide) and a closed drawer (narrow) are removed from the accessibility tree and the tab order",
      "trigger with collapsible=none on a wide viewport: hidden, since it controls nothing there",
      "forced colors: the current item keeps a visible marker (Highlight) and the panel keeps its border",
      "closing the panel from code (expanded = false) while focus is inside it moves focus to the trigger",
      "trigger: aria-keyshortcuts=\"Control+B Meta+B\" announces the toggle shortcut"
    ],
