  "aiHints": {
    "category": "organism",
    "keywords": [
      "sidebar",
      "side navigation",
      "nav",
      "drawer",
      "off-canvas",
      "docs navigation",
      "app shell"
    ],
    "useCases": [
      {
        "when": "Primary navigation of an app or docs site with many pages in a few sections",
        "use": "sb-sidebar-provider with sb-sidebar, groups with a group label, menu buttons with href and active on the current page"
      },
      {
        "when": "The panel may be hidden on wide screens to give the content room",
        "use": "collapsible=offcanvas (default) and an sb-sidebar-trigger in the content header"
      },
      {
        "when": "The panel must always stay visible on wide screens",
        "use": "collapsible=none; the trigger still opens the drawer on narrow screens"
      }
    ],
    "antiPatterns": [
      {
        "pattern": "Menu or menuitem roles on the site links",
        "why": "The APG reserves menu roles for application menus; site navigation is a landmark with a list of links",
        "alternative": "Keep the list and link semantics the sidebar provides"
      },
      {
        "pattern": "Two navigations on a page with the same name",
        "why": "The APG asks for a unique label per navigation landmark so they can be told apart",
        "alternative": "Set a distinct label on the sidebar (for example \"Documentation\")"
      },
      {
        "pattern": "Placing the trigger inside the sidebar",
        "why": "The trigger must stay reachable while the panel is collapsed or the drawer closed",
        "alternative": "Put sb-sidebar-trigger in the main content's header, inside the provider"
      }
    ]
  },
