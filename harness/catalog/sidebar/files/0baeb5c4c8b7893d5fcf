  "elements": [
    {
      "tag": "sb-sidebar-provider",
      "summary": "Wraps the sidebar and the main content: lays them out side by side, owns the expanded state and shares it with the sidebar and its trigger.",
      "props": {
        "expanded": {
          "type": "boolean",
          "default": true,
          "reflect": true,
          "note": "Wide viewports: whether the panel is shown. Unlike Collapsible's expanded, it defaults to true on purpose: the navigation is visible until someone hides it. The trigger flips it; code can set it too. The narrow-viewport drawer has its own state, which always starts closed."
        }
      },
      "anatomy": [
        {
          "name": "wrapper",
          "role": "container",
          "parent": null,
          "part": "wrapper",
          "notes": "Row with the panel at the inline start and the main content filling the rest."
        }
      ],
      "content": {
        "default": {
          "required": true,
          "multiple": true,
          "component": "sb-sidebar",
          "notes": "One sb-sidebar and the page's main content, which holds the sb-sidebar-trigger."
        }
      },
      "events": {
        "sb-toggle": {
          "bubbles": true,
          "composed": true,
          "cancelable": false,
          "native": false,
          "detail": null,
          "note": "Fires on the provider after expanded changes, from the trigger or from code. Named and shaped like Collapsible's and Dialog's sb-toggle on purpose. Read host.expanded. Not fired for the drawer."
        }
      },
      "notes": "Every sb-sidebar and sb-sidebar-trigger must be a descendant of one provider. One sb-sidebar per provider; a sidebar added later is picked up. If --sb-sidebar-breakpoint resolves empty, the provider warns once and stays wide."
    },
    {
      "tag": "sb-sidebar-header",
      "summary": "Region at the top of the panel that does not scroll (a product name, a search).",
      "anatomy": [
        {
          "name": "header",
          "role": "container",
          "parent": null,
          "part": "header",
          "notes": "Column with the panel's padding and gap."
        }
      ],
      "content": {
        "default": {
          "required": true,
          "multiple": true,
          "notes": "Any content."
        }
      },
      "notes": "Optional; first child of sb-sidebar."
    },
    {
      "tag": "sb-sidebar-content",
      "summary": "The region between header and footer that holds the groups and scrolls when they overflow.",
      "anatomy": [
