{
  "$schema": "../../schemas/contract.schema.json",
  "component": "Sidebar",
  "tag": "sb-sidebar",
  "status": "stable",
  "version": "0.1.0",
  "platforms": [
    "web",
    "design"
  ],
  "summary": "A named navigation panel at the start edge of an app or docs layout: a header, groups of links with a group label, the current page marked, and a footer. On wide viewports it can collapse off-canvas; on narrow viewports it becomes a modal drawer opened by a trigger. Eleven custom elements share state through a provider.",
  "dependsOn": [],
  "props": {
    "label": {
      "type": "text",
      "default": "Sidebar",
      "reflect": true,
      "note": "Accessible name of the navigation landmark, and of the drawer on narrow viewports. Give a page's navigations distinct names.",
      "proposal": true
    },
    "collapsible": {
      "type": "variant",
      "values": [
        "offcanvas",
        "none"
      ],
      "default": "offcanvas",
      "reflect": true,
      "note": "Wide viewports only. offcanvas slides the panel out of the layout when the provider is closed; none keeps it always shown and hides the trigger there. Narrow viewports always use the drawer."
    }
  },
  "anatomy": [
    {
      "name": "root",
      "role": "container",
      "parent": null,
      "part": "root",
      "notes": "sb-sidebar: the panel at the inline-start edge, a column of header, content and footer."
    },
    {
      "name": "nav",
      "role": "container",
      "parent": "root",
      "part": "nav",
      "notes": "The navigation landmark, named by label; holds every slotted part."
    },
    {
      "name": "drawer",
      "role": "container",
      "parent": "root",
      "part": "drawer",
      "optional": true,
      "notes": "PROPOSAL. Narrow viewports only: the modal surface the nav sits in while open."
    }
  ],
  "variantMatrix": {
    "dimensions": {
      "collapsible": [
        "offcanvas",
        "none"
      ]
    }
  },
  "content": {
    "default": {
      "required": true,
      "multiple": true,
      "component": "sb-sidebar-header, sb-sidebar-content, sb-sidebar-footer",
      "notes": "Optional header, one content region, optional footer, in that order."
    }
  },
  "events": {},
  "states": {
    "hover": {
      "trigger": "pointer over a menu button or the trigger",
      "tokens": [
        "sidebar.menu-button.hover.bg",
        "sidebar.menu-button.hover.fg",
        "sidebar.trigger.hover.bg"
      ]
    },
    "selected": {
      "trigger": "active on a menu button (the current page)",
      "tokens": [
        "sidebar.menu-button.active.bg",
        "sidebar.menu-button.active.fg",
        "sidebar.menu-button.active.font-weight"
      ],
      "note": "Spelled active in code, like the pagination link; exposed as the current page."
    },
    "focus-visible": {
      "trigger": "keyboard focus on a menu button or the trigger",
      "tokens": [
        "sidebar.focus-ring.color",
        "sidebar.focus-ring.width"
      ]
    },
    "open": {
      "trigger": "the provider opens or closes the panel (wide) or the drawer (narrow)",
