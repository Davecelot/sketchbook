@use 'a11y';

:host {
  display: block;
}

:host([hidden]) {
  display: none;
}

[part='viewport'] {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  max-height: inherit;
  overflow-x: hidden;
  overflow-y: hidden;
  border-radius: inherit;
  scrollbar-width: thin;
  scrollbar-color: var(--sb-scroll-area-thumb) transparent;
  outline: none;

  &:focus-visible {
    @include a11y.focus-ring(var(--sb-scroll-area-focus-ring-color), var(--sb-scroll-area-focus-ring-width));
  }
}

:host([data-axis-x]) [part='viewport'] {
  overflow-x: auto;
}

:host([data-axis-y]) [part='viewport'] {
  overflow-y: auto;
}

// Wide content must grow the wrapper so a resize observer notices horizontal overflow.
:host([data-axis-x]) [part='content'] {
  width: max-content;
  min-width: 100%;
}

:host(sb-scroll-bar) {
  display: none;
}
