#!/bin/sh
# Validation that can reject: the deterministic checks run before every commit.
# Exit 1 (fail) blocks the commit; exit 2 (pass with flagged overrides) is allowed.
# The Sketchbook source repo runs its own harness/; a project runs the engine it installed (node_modules/.bin/sketchbook).
# mktemp, not /tmp/name.$$: a predictable path on a shared machine can be planted as a symlink.
out=$(mktemp) || exit 1
trap 'rm -f "$out"' EXIT
# The source repo is told apart by its build script: harness/checks/run.mjs is compiled, so a fresh clone has none yet.
if [ -f scripts/build-harness.mjs ]; then
  node scripts/build-harness.mjs > "$out" 2>&1 && node harness/checks/run.mjs >> "$out" 2>&1
elif [ -x node_modules/.bin/sketchbook ]; then
  node_modules/.bin/sketchbook check > "$out" 2>&1
else
  echo "Commit blocked: the Sketchbook engine is not installed here (node_modules/.bin/sketchbook). Run npm install, then commit again."
  exit 1
fi
status=$?
if [ "$status" -eq 1 ]; then
  cat "$out"
  echo "\nCommit blocked: npm run check failed. Fix the spec (or rebuild with npm run generate), then commit again."
  exit 1
fi
exit 0
