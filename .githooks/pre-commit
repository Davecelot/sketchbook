#!/bin/sh
# Validation that can reject: the deterministic checks run before every commit.
# Exit 1 (fail) blocks the commit; exit 2 (pass with flagged overrides) is allowed.
# The Sketchbook source repo runs its own harness/; a project runs the engine it installed (node_modules/.bin/sketchbook).
# mktemp, not /tmp/name.$$: a predictable path on a shared machine can be planted as a symlink.
out=$(mktemp) || exit 1
trap 'rm -f "$out"' EXIT
# The source repo is told apart by its build script: harness/checks/run.mjs is compiled, so a fresh clone has none yet.
if [ -f scripts/build-harness.mjs ]; then
  if [ -f docs/content-guidelines.md ]; then
    git diff --cached --quiet --diff-filter=ACMRT -- \
      'README.md' ':(glob)apps/docs/content/**/*.md' ':(glob)docs/**/*.md' \
      ':(glob)harness/templates/project/docs/**/*.md' ':(glob)harness/templates/agent-catalog/**/*.md' \
      ':(glob)harness/cli/**/*.mts' ':(glob)harness/commands/**/*.mts' \
      ':(glob)harness/starters/*.json' ':(exclude)docs/cli.md'
    if [ "$?" -eq 1 ]; then
      printf '%s\n' 'Content review: see docs/content-guidelines.md.' \
        'Check that readers can find the next action, what it changes, and how to verify the result.'
    fi
  fi
  if ! node scripts/build-harness.mjs > "$out" 2>&1; then
    cat "$out"
    printf '\nCommit blocked: the Sketchbook harness failed to build.\n'
    exit 1
  fi
  node harness/checks/run.mjs >> "$out" 2>&1
elif [ -x node_modules/.bin/sketchbook ]; then
  node_modules/.bin/sketchbook check > "$out" 2>&1
else
  echo "Commit blocked: the Sketchbook engine is not installed here (node_modules/.bin/sketchbook). Run npm install, then commit again."
  exit 1
fi
status=$?
if [ "$status" -ne 0 ] && [ "$status" -ne 2 ]; then
  cat "$out"
  printf '\nCommit blocked: Sketchbook check failed (exit %s). Fix the diagnostics above, then commit again.\n' "$status"
  exit 1
fi
exit 0
