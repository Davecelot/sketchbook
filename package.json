{
  "name": "@usesketchbook/cli",
  "version": "0.2.0",
  "description": "Provider-neutral harness for building an accessible, white-label Web Components design system from a spec.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davecelot/sketchbook.git"
  },
  "bugs": {
    "url": "https://github.com/Davecelot/sketchbook/issues"
  },
  "homepage": "https://sketchbook-docs.vercel.app",
  "engines": {
    "node": "^22.18 || >=24"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./generated/css/tokens.css",
    "./fonts.css": "./generated/css/fonts.css",
    "./bundle": "./dist/sketchbook.js",
    "./harness/*": "./harness/*"
  },
  "imports": {
    "#harness/*": "./harness/*"
  },
  "files": [
    "dist",
    "generated/css/tokens.css",
    "generated/css/fonts.css",
    "generated/types",
    "THIRD_PARTY_NOTICES.md",
    "harness",
    "scripts",
    ".claude/skills",
    ".claude/commands",
    ".claude/rules",
    ".claude/hooks",
    ".githooks",
    "brand",
    "docs/cli.md",
    "docs/agent-compatibility.md",
    "spec/schemas"
  ],
  "sideEffects": [
    "./dist/**/*.js",
    "./src/index.ts",
    "./src/components/**/*.ts",
    "./generated/css/*.css"
  ],
  "bin": {
    "sketchbook": "./harness/cli.mjs"
  },
  "scripts": {
    "presketchbook": "npm run -s build:harness",
    "sketchbook": "node harness/cli.mjs",
    "tokens:generate": "node harness/generators/foundation.mjs",
    "tokens:build": "node harness/build/index.mjs",
    "tokens": "npm run tokens:generate && npm run tokens:build",
    "precheck": "npm run -s build:harness",
    "check": "node harness/checks/run.mjs",
    "check:maintainer": "node harness/checks/run.mjs --maintainer",
    "verify": "npm run check && npm run test:harness && npm run typecheck && git diff --exit-code && npm run lint && node scripts/audit.mjs && npm run build-storybook && CI=true npm run test:component",
    "propagate": "node harness/cli.mjs propagate",
    "propagate:maintainer": "node harness/cli.mjs propagate --maintainer",
    "check:json": "node harness/checks/run.mjs --json",
    "pretest:harness": "npm run -s build:harness",
    "test:harness": "node --test harness/test/*.test.mjs",
    "pretest:wall": "npm run -s build:harness",
    "test:wall": "node --test harness/test/wall.mjs",
    "pretest:reference-sync": "npm run -s build:harness",
    "test:reference-sync": "node harness/test/sync-reference.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "build:barrel": "node scripts/build-barrel.mjs",
    "build:cli-docs": "node harness/cli/docs.mjs && node harness/cli/known.mjs",
    "build:schema-types": "node scripts/build-schema-types.mjs",
    "build:harness": "node scripts/build-harness.mjs",
    "build:interface": "node harness/lib/interface.mjs",
    "pregenerate": "npm run -s build:harness",
    "generate": "npm run tokens:build && npm run brands:build && npm run build:styles && npm run build:barrel && npm run build:schema-types && npm run build:interface && npm run build:cli-docs && npm run catalog:build",
    "build": "npm run generate && tsup",
    "prepack": "npm run build 1>&2",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,scss}\" \"playwright/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.stories.json && tsc -p tsconfig.tools.json",
    "typecheck:harness": "tsc --noEmit --incremental false -p tsconfig.harness.json",
    "pretypecheck": "npm run generate && tsc --noEmit -p apps/docs/tsconfig.browser.json",
    "storybook": "npm run generate && storybook dev -p ${SKETCHBOOK_PORT:-6006}",
    "build-storybook": "storybook build",
    "prebuild-storybook": "npm run generate",
    "test:component": "playwright test -c playwright/playwright.config.ts",
    "test:install": "playwright install chromium",
    "templates:sync": "cp spec/tokens/semantic/*.tokens.json harness/templates/semantic/",
    "catalog:build": "node scripts/build-catalog.mjs",
    "brands:build": "node harness/commands/brand.mjs",
    "docs:build": "npm run build && npm run docs:components && node apps/docs/scripts/docs-site.mjs",
    "predocs:components": "npm run -s build:harness",
    "docs:components": "node apps/docs/scripts/docs-components.mjs",
    "docs:serve": "http-server site-dist -p 4173 -c-1"
  },
  "dependencies": {
    "lucide-static": "1.76.0",
    "postcss": "8.5.33",
    "postcss-scss": "4.0.9",
    "sass": "1.108.2",
    "style-dictionary": "5.8.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@lit/context": "^1.1.6",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@lit/context": "1.1.6",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/web-components-vite": "10.6.7",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-lit-a11y": "5.1.3",
    "globals": "17.14.0",
    "http-server": "14.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "lit": "3.3.3",
    "markdown-it": "15.0.3",
    "minisearch": "7.2.0",
    "prettier": "3.10.1",
    "storybook": "10.6.7",
    "tsup": "9.0.0",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "html-encoding-sniffer": "^7.0.0",
    "glob": "^14.0.6"
  }
}
