import { readFile, writeFile } from 'node:fs/promises';

interface Release {
  tag_name: string;
  published_at: string | null;
  draft: boolean;
  prerelease: boolean;
  body: string | null;
}

const { name, repository } = JSON.parse(await readFile('package.json', 'utf8')) as {
  name: string;
  repository: { url: string };
};
const repo = new URL(repository.url.replace(/^git\+/, '').replace(/\.git$/, ''));
const releaseApi = `https://api.github.com/repos${repo.pathname}/releases`;
const destination = 'apps/docs/content/changelog/index.md';
const pageSize = 100;
const versionTag = /^v(\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?)$/;

async function getJson<T>(url: string, accept: string): Promise<T> {
  const response = await fetch(url, { headers: { accept }, signal: AbortSignal.timeout(15_000) });
  if (!response.ok) throw new Error(`${url}: HTTP ${response.status}. The changelog was not updated.`);
  return (await response.json()) as T;
}

const { versions } = await getJson<{ versions: Record<string, unknown> }>(
  `https://registry.npmjs.org/${encodeURIComponent(name)}`,
  'application/vnd.npm.install-v1+json'
);
const releases: Release[] = [];
for (let page = 1; ; page++) {
  const batch = await getJson<Release[]>(`${releaseApi}?per_page=${pageSize}&page=${page}`, 'application/vnd.github+json');
  releases.push(...batch);
  if (batch.length < pageSize) break;
}

const date = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' });
const entries = releases
  .filter((release): release is Release & { published_at: string } => !release.draft && !!release.published_at)
  .sort((a, b) => b.published_at.localeCompare(a.published_at) || b.tag_name.localeCompare(a.tag_name))
  .flatMap(({ tag_name: tag, body, published_at: published, prerelease }) => {
    const version = tag.match(versionTag)?.[1];
    if (!version || !Object.hasOwn(versions, version)) {
      console.warn(`Skipping ${tag}: no matching public npm version.`);
      return [];
    }
    const tagPath = encodeURIComponent(tag);
    const links = [
      `[GitHub release ${tag}](${repo}/releases/tag/${tagPath})`,
      `[Tagged source ${tag}](${repo}/tree/${tagPath})`,
      `[npm package ${version}](https://www.npmjs.com/package/${name}/v/${encodeURIComponent(version)})`
    ];
    const notes = body?.replace(/\r\n?/g, '\n').trim();
    return [`## ${tag}\n\n${date.format(new Date(published))}${prerelease ? ' · Prerelease' : ''}\n\n${links.join(' · ')}${notes ? `\n\n${notes}` : ''}`];
  });

if (!entries.length) throw new Error('No published GitHub releases with matching npm versions. The changelog was not updated.');

await writeFile(destination, `---
title: Changelog
description: See what changed in public Sketchbook releases and find the matching code and package.
source: Generated by apps/docs/scripts/sync-changelog.mts
---

Links to this docs site point to the current documentation. Use the tagged source to browse files from a specific release.

${entries.join('\n\n')}\n`);
console.log(`Synced ${entries.length} releases to ${destination}`);
